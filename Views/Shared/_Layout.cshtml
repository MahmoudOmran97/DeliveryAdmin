<!DOCTYPE html>
@using System.Globalization
@using DeliveryAdmin.Services
@inject ApiService Api
@inject IConfiguration Configuration


@{
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = lang == "ar";
}
<html lang="@lang" dir="@(isRtl ? "rtl" : "ltr")" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>@ViewData["Title"] — Tawseela Admin</title>

    <!-- PWA: installable as an app on phone/tablet -->
    <link rel="manifest" href="~/manifest.json">
    <meta name="theme-color" content="#FF5722">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Tawseela">

    <!-- Icons / favicon (Tawseela logo) -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/icons/icon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icons/icon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/icons/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    @if (isRtl) { <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet"> }
    <link rel="stylesheet" href="~/css/admin.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/admin.js" defer></script>
</head>
<body class="@(isRtl ? "rtl-font" : "")">

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="sidebar" id="sidebar">
        <div class="logo">
            <div class="logo-mark">
                <img src="~/images/logo.png" alt="Tawseela" class="logo-icon" />
                <div>
                    <div class="logo-text">Tawseela</div>
                    <div class="logo-sub">@Localizer["AdminPanel"]</div>
                </div>
            </div>
            <button type="button" class="sidebar-close" id="sidebarClose" aria-label="Close menu">✕</button>
        </div>
        <nav class="nav">
            @{
                var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
                var act = ViewContext.RouteData.Values["action"]?.ToString();
                var isStoreOwner = User.IsInRole("Restaurant");
                var isPharmacyStore = false;
                if (isStoreOwner)
                {
                    var myStore = await Api.GetMyRestaurant();
                    isPharmacyStore = string.Equals(myStore?.StoreType, "Pharmacy", StringComparison.OrdinalIgnoreCase);
                }
            }
            @if (isStoreOwner)
            {
                <div class="nav-section">@Localizer["Nav_Main"]</div>
                <a class="nav-item @(ctrl == "MyStore" && act == "Index" ? "active" : "")" asp-controller="MyStore" asp-action="Index"><span class="nav-icon">🏪</span> @Localizer["Nav_MyStore"]</a>
                @* المنيو بقى متاح للصيدلية برضو (منتجات OTC/تصنيفات) مش بس للمطاعم *@
                <a class="nav-item @(ctrl == "MyStore" && act == "Menu" ? "active" : "")" asp-controller="MyStore" asp-action="Menu"><span class="nav-icon">🍽️</span> @Localizer["Nav_MyMenu"]</a>
                <a class="nav-item @(ctrl == "MyStore" && act == "Orders" ? "active" : "")" asp-controller="MyStore" asp-action="Orders"><span class="nav-icon">📦</span> @Localizer["Nav_MyOrders"]</a>
                <a class="nav-item @(ctrl == "MyStore" && act == "Drivers" ? "active" : "")" asp-controller="MyStore" asp-action="Drivers"><span class="nav-icon">🛵</span> @Localizer["Nav_MyDrivers"]</a>
                <a class="nav-item @(ctrl == "MyStore" && act == "Ratings" ? "active" : "")" asp-controller="MyStore" asp-action="Ratings"><span class="nav-icon">⭐</span> @Localizer["Nav_MyRatings"]</a>
                @if (isPharmacyStore)
                {
                    <a class="nav-item @(ctrl == "Pharmacy" ? "active" : "")" asp-controller="Pharmacy" asp-action="Index"><span class="nav-icon">💊</span> @Localizer["Pharmacy_Title"]</a>
                }
            }
            else
            {
                <div class="nav-section">@Localizer["Nav_Main"]</div>
                <a class="nav-item @(ctrl == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><span class="nav-icon">📊</span> @Localizer["Nav_Dashboard"]</a>
                <a class="nav-item @(ctrl == "Orders" ? "active" : "")" asp-controller="Orders" asp-action="Index"><span class="nav-icon">📦</span> @Localizer["Nav_Orders"]</a>
                <a class="nav-item @(ctrl == "Drivers" ? "active" : "")" asp-controller="Drivers" asp-action="Index"><span class="nav-icon">🛵</span> @Localizer["Nav_Drivers"]</a>
                <a class="nav-item @(ctrl == "Restaurants" ? "active" : "")" asp-controller="Restaurants" asp-action="Index"><span class="nav-icon">🍽️</span> @Localizer["Nav_Restaurants"]</a>
                <a class="nav-item @(ctrl == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index"><span class="nav-icon">👥</span> @Localizer["Nav_Users"]</a>
                <div class="nav-section">@Localizer["Nav_Finance"]</div>
                <a class="nav-item @(ctrl == "Settlements" ? "active" : "")" asp-controller="Settlements" asp-action="Index"><span class="nav-icon">📋</span> @Localizer["Nav_Settlements"]</a>
                <a class="nav-item @(ctrl == "DeliverySettings" ? "active" : "")" asp-controller="DeliverySettings" asp-action="Index"><span class="nav-icon">🚚</span> Delivery Fee</a>
                <a class="nav-item @(ctrl == "Payments" ? "active" : "")" asp-controller="Payments" asp-action="Index"><span class="nav-icon">💳</span> @Localizer["Nav_Payments"]</a>
                <a class="nav-item @(ctrl == "Ratings" ? "active" : "")" asp-controller="Ratings" asp-action="Index"><span class="nav-icon">⭐</span> @Localizer["Nav_Ratings"]</a>
                <div class="nav-section">@Localizer["Nav_Catalog"]</div>
                <a class="nav-item @(ctrl == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index"><span class="nav-icon">🍕</span> @Localizer["Nav_Products"]</a>
                <a class="nav-item @(ctrl == "Restaurants" ? "active" : "")" asp-controller="Restaurants" asp-action="Index"><span class="nav-icon">📂</span> @Localizer["Nav_Categories"]</a>
                <div class="nav-section">@Localizer["Nav_Marketing"]</div>
                <a class="nav-item @(ctrl == "Coupons" ? "active" : "")" asp-controller="Coupons" asp-action="Index"><span class="nav-icon">🎟️</span> @Localizer["Nav_Coupons"]</a>
                <a class="nav-item @(ctrl == "Deals" ? "active" : "")" asp-controller="Deals" asp-action="Index"><span class="nav-icon">🔥</span> @Localizer["Nav_Deals"]</a>
                <a class="nav-item @(ctrl == "Banners" ? "active" : "")" asp-controller="Banners" asp-action="Index"><span class="nav-icon">🖼️</span> @Localizer["Nav_Banners"]</a>
                <div class="nav-section">@Localizer["Nav_Notifications"]</div>
                <a class="nav-item @(ctrl == "Notifications" ? "active" : "")" asp-controller="Notifications" asp-action="Send"><span class="nav-icon">🔔</span> @Localizer["Notif_Title"]</a>
            }
        </nav>
        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-av">@((Context.Session.GetString("UserName") is { Length: > 0 } n ? n[0].ToString().ToUpper() : "A"))</div>
                <div>
                    <div class="user-name">@(Context.Session.GetString("UserName") ?? "Admin")</div>
                    <div class="user-role">@(Context.Session.GetString("UserRole") ?? "Admin")</div>
                </div>
            </div>
            <a class="logout-btn" asp-controller="Auth" asp-action="Logout">🚪 @Localizer["Logout"]</a>
        </div>
    </aside>

    <main class="main">
        <header class="header">
            <div class="header-left">
                <button type="button" class="hamburger-btn" id="sidebarOpen" aria-label="Open menu">
                    <span></span><span></span><span></span>
                </button>
                <div>
                    <div class="page-title">@ViewData["Title"]</div>
                    <div class="page-bc">dashboard / @ViewData["Title"]?.ToString()?.ToLower()</div>
                </div>
            </div>
            <div class="header-right">
                <div class="toolbar">
                    <button type="button" class="toolbar-btn" id="themeToggle" title="@Localizer["Theme_Light"]">🌙</button>
                    <form asp-controller="Settings" asp-action="SetLanguage" method="post" class="lang-form">
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <select name="culture" class="lang-select" onchange="this.form.submit()">
                            @if (lang == "en") { <option value="en" selected>@Localizer["Lang_English"]</option> } else { <option value="en">@Localizer["Lang_English"]</option> }
                            @if (lang == "ar") { <option value="ar" selected>@Localizer["Lang_Arabic"]</option> } else { <option value="ar">@Localizer["Lang_Arabic"]</option> }
                        </select>
                    </form>
                    <div class="notif-bell-wrap" id="notifBellWrap">
                        <button type="button" class="toolbar-btn notif-bell-btn" id="notifBellBtn" title="@Localizer["Notif_Bell"]">
                            🔔
                            <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
                        </button>
                        <div class="notif-dropdown" id="notifDropdown" style="display:none;">
                            <div class="notif-dropdown-header">
                                <span>@Localizer["Notif_Bell"]</span>
                                <button type="button" id="notifMarkAllBtn">@Localizer["Notif_MarkAllRead"]</button>
                            </div>
                            <div class="notif-list" id="notifList">
                                <div class="notif-loading">…</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="live"><div class="live-dot"></div> @Localizer["Live"]</div>
            </div>
        </header>
        <div class="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">✅ @TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">❌ @TempData["Error"]</div>
            }
            @RenderBody()
        </div>
    </main>

    @RenderSection("Scripts", required: false)

    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/service-worker.js').catch(function (err) {
                    console.error('SW registration failed:', err);
                });
            });
        }
    </script>

    <!-- ─────────────────────────────────────────────────────────────
         زر الجرس 🔔 — متاح للأدمن وصاحب المحل مع بعض. بيعرض عدد
         التنبيهات اللي لسه ملقتش (بولينج كل 25 ثانية + تحديث لحظي
         عن طريق SignalR تحت)، وبيفتح قائمة بآخر التنبيهات المحفوظة.
    ───────────────────────────────────────────────────────────────── -->
    <script>
    (function () {
        var badge = document.getElementById('notifBadge');
        var btn = document.getElementById('notifBellBtn');
        var dropdown = document.getElementById('notifDropdown');
        var list = document.getElementById('notifList');
        var markAllBtn = document.getElementById('notifMarkAllBtn');
        if (!btn || !dropdown) return;

        var isRtl = @Html.Raw(isRtl ? "true" : "false");
        var emptyText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Notif_Empty"].Value));
        var isOpen = false;
        var loadedOnce = false;

        function timeAgo(iso) {
            var diffSec = Math.max(0, (Date.now() - new Date(iso + 'Z').getTime()) / 1000);
            if (diffSec < 60) return isRtl ? 'دلوقتي' : 'now';
            if (diffSec < 3600) return Math.floor(diffSec / 60) + (isRtl ? ' د' : 'm');
            if (diffSec < 86400) return Math.floor(diffSec / 3600) + (isRtl ? ' س' : 'h');
            return Math.floor(diffSec / 86400) + (isRtl ? ' يوم' : 'd');
        }

        function notifUrl(n) {
            if (n.type === 'PrescriptionRequest') return '/Pharmacy';
            if (n.orderId) return @Html.Raw(isStoreOwner ? "'/MyStore/Orders'" : "'/Orders/Details/' + n.orderId");
            return '#';
        }

        function renderList(items) {
            if (!items || !items.length) {
                list.innerHTML = '<div class="notif-empty-state">🔕<br>' + emptyText + '</div>';
                return;
            }
            list.innerHTML = items.map(function (n) {
                return '<a href="' + notifUrl(n) + '" class="notif-item' + (n.isRead ? '' : ' unread') + '" data-id="' + n.id + '">' +
                    '<div class="notif-item-title">' + escapeHtml(n.title) + '</div>' +
                    '<div class="notif-item-body">' + escapeHtml(n.body) + '</div>' +
                    '<div class="notif-item-time">' + timeAgo(n.createdAt) + '</div>' +
                    '</a>';
            }).join('');

            Array.prototype.forEach.call(list.querySelectorAll('.notif-item'), function (el) {
                el.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');
                    fetch('/Notifications/MarkRead?id=' + id, { method: 'POST' }).catch(function () {});
                });
            });
        }

        function escapeHtml(s) {
            var d = document.createElement('div');
            d.textContent = s || '';
            return d.innerHTML;
        }

        function refreshBadge() {
            fetch('/Notifications/UnreadCount').then(function (r) { return r.json(); }).then(function (d) {
                var count = d && d.count ? d.count : 0;
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.style.display = 'flex';
                } else {
                    badge.style.display = 'none';
                }
            }).catch(function () {});
        }

        function loadFeed() {
            list.innerHTML = '<div class="notif-loading">…</div>';
            fetch('/Notifications/Feed').then(function (r) { return r.json(); }).then(function (d) {
                renderList(d && d.data ? d.data : []);
            }).catch(function () {
                list.innerHTML = '<div class="notif-empty-state">⚠️</div>';
            });
        }

        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            isOpen = !isOpen;
            dropdown.style.display = isOpen ? 'block' : 'none';
            if (isOpen) {
                loadFeed();
                loadedOnce = true;
                setTimeout(refreshBadge, 600); // بعد ما نفتح القائمة نفترض إنه هيقرا، نحدث العداد شوية بعدين
            }
        });

        document.addEventListener('click', function (e) {
            if (isOpen && !dropdown.contains(e.target) && e.target !== btn) {
                isOpen = false;
                dropdown.style.display = 'none';
            }
        });

        if (markAllBtn) {
            markAllBtn.addEventListener('click', function () {
                fetch('/Notifications/MarkAllRead', { method: 'POST' }).then(function () {
                    refreshBadge();
                    if (loadedOnce) loadFeed();
                }).catch(function () {});
            });
        }

        refreshBadge();
        setInterval(refreshBadge, 25000);

        // بيتنادى من بلوك الـ SignalR تحت لما يوصل حدث "NewNotification" لحظي
        window.__onLiveNotification = function () {
            refreshBadge();
            if (isOpen) loadFeed();
        };
    })();
    </script>

    @{
        var apiBase = (Configuration["ApiSettings:BaseUrl"] ?? "").TrimEnd('/');
        var hubBaseUrl = apiBase.EndsWith("/api") ? apiBase[..^4] : apiBase;
        var myToken = Api.GetCurrentToken();
    }

    <!-- ─────────────────────────────────────────────────────────────
         تنبيه لحظي جامد (صوت + كارت في نص الشاشة) لما يجي طلب جديد
         أو روشتة جديدة — للأدمن وصاحب المحل مع بعض. الصوت بيفضل
         يعيد نفسه لحد ما تدوس تفتح/تقفل، عشان محدش يفوّته وهو مشغول.
    ───────────────────────────────────────────────────────────────── -->
    <audio id="loudAlertSound" preload="auto" loop>
        <source src="https://actions.google.com/sounds/v1/alarms/alarm_clock.ogg" type="audio/ogg" />
    </audio>
    <div id="notifCenterOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:99999;align-items:center;justify-content:center;padding:16px;">
        <div id="notifCenterCard" style="background:var(--bg2);border:1px solid var(--border2);border-radius:18px;padding:30px 26px;max-width:380px;width:100%;text-align:center;box-shadow:0 24px 70px rgba(0,0,0,.55);">
            <div style="font-size:46px;line-height:1;">🔔</div>
            <div id="notifCenterTitle" style="font-size:18px;font-weight:800;color:var(--text);margin-top:12px;"></div>
            <div id="notifCenterBody" style="font-size:13px;color:var(--text2);margin-top:8px;line-height:1.6;"></div>
            <div style="display:flex;gap:10px;margin-top:22px;">
                <button type="button" id="notifCenterViewBtn" class="btn" style="flex:1;">@Localizer["Orders_ViewOrder"]</button>
                <button type="button" id="notifCenterDismissBtn" class="btn btn-secondary" style="flex:1;">@Localizer["Notif_Dismiss"]</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
    (function () {
        var isStoreOwner = @Html.Raw(isStoreOwner ? "true" : "false");

        // ── الكارت الجامد في نص الشاشة + الصوت اللي بيفضل شغال ──────────
        var overlay = document.getElementById('notifCenterOverlay');
        var sound = document.getElementById('loudAlertSound');
        var titleEl = document.getElementById('notifCenterTitle');
        var bodyEl = document.getElementById('notifCenterBody');
        var viewBtn = document.getElementById('notifCenterViewBtn');
        var dismissBtn = document.getElementById('notifCenterDismissBtn');
        var autoStopTimer = null;

        function stopAlert() {
            overlay.style.display = 'none';
            if (sound) { sound.pause(); sound.currentTime = 0; }
            if (autoStopTimer) { clearTimeout(autoStopTimer); autoStopTimer = null; }
        }

        function showCenterAlert(title, body, url) {
            titleEl.textContent = title || '🔔';
            bodyEl.textContent = body || '';
            overlay.style.display = 'flex';
            if (sound) { sound.currentTime = 0; sound.play().catch(function () {}); }

            viewBtn.onclick = function () {
                stopAlert();
                if (url && url !== '#') window.location.href = url;
            };
            dismissBtn.onclick = stopAlert;

            // منوقفش الصوت لوحده - بس بعد دقيقتين نوقفه تلقائي عشان محدش ينسى التاب مفتوح
            if (autoStopTimer) clearTimeout(autoStopTimer);
            autoStopTimer = setTimeout(stopAlert, 120000);
        }

        var hubBase = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(hubBaseUrl));
        var token = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(myToken ?? ""));
        if (!hubBase || !token) return;

        var connection = new signalR.HubConnectionBuilder()
            .withUrl(hubBase + "/hubs/tracking", { accessTokenFactory: () => token })
            .withAutomaticReconnect()
            .build();

        // 🔔 حدث عام بيتبعت لأي مستخدم (أدمن أو صاحب محل) لما يتحفظله تنبيه
        // جديد في الجرس — سواء أوردر جديد، روشتة جديدة، أو بث يدوي من الأدمن
        connection.on("NewNotification", function (data) {
            if (typeof window.__onLiveNotification === 'function') window.__onLiveNotification();
            if (!data) return;

            var isOrderish = data.type === 'NewOrder' || data.type === 'PrescriptionRequest';
            if (isOrderish) {
                var url = data.type === 'PrescriptionRequest'
                    ? '/Pharmacy'
                    : (isStoreOwner ? '/MyStore/Orders' : (data.orderId ? '/Orders/Details/' + data.orderId : '#'));
                showCenterAlert(data.title, data.body, url);
            } else if ("Notification" in window && Notification.permission === "granted") {
                // تنبيهات تانية (بث يدوي من الأدمن مثلاً) بتاخد إشعار متصفح عادي بس
                new Notification(data.title || "🔔", { body: data.body || "", icon: "🔔" });
            }
        });

        connection.start().catch(function (err) { console.error('SignalR connection error:', err); });

        if ("Notification" in window && Notification.permission === "default") {
            Notification.requestPermission();
        }
    })();
    </script>

    @{ var hasFirebaseWeb = !string.IsNullOrWhiteSpace(Configuration["FirebaseWeb:ApiKey"]); }
    @if (hasFirebaseWeb)
    {
        <!-- ─────────────────────────────────────────────────────────────
             تسجيل توكن الـ Web Push — يخلي التنبيهات توصل حتى لو التاب
             مقفول أو الأدمن بورتال متسطبة كـ PWA وقافلها. لو الإعدادات في
             FirebaseWeb فاضية في appsettings.json، البلوك ده مش بيترندر خالص.
        ───────────────────────────────────────────────────────────────── -->
        <script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-app-compat.js"></script>
        <script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-messaging-compat.js"></script>
        <script>
        (function () {
            var apiToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(myToken ?? ""));
            var apiBase = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBase));
            var vapidKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["FirebaseWeb:VapidKey"] ?? ""));
            if (!apiToken || !vapidKey || !('serviceWorker' in navigator)) return;

            navigator.serviceWorker.register('/firebase-messaging-sw.js').then(function (registration) {
                var app = firebase.initializeApp({
                    apiKey: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["FirebaseWeb:ApiKey"])),
                    authDomain: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["FirebaseWeb:AuthDomain"])),
                    projectId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["FirebaseWeb:ProjectId"])),
                    storageBucket: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["FirebaseWeb:StorageBucket"])),
                    messagingSenderId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["FirebaseWeb:MessagingSenderId"])),
                    appId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["FirebaseWeb:AppId"]))
                });
                var messaging = firebase.messaging(app);

                function registerToken() {
                    if (Notification.permission !== "granted") return;
                    messaging.getToken({ vapidKey: vapidKey, serviceWorkerRegistration: registration })
                        .then(function (token) {
                            if (!token) return;
                            fetch(apiBase + '/user/fcm-token', {
                                method: 'PUT',
                                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + apiToken },
                                body: JSON.stringify({ token: token })
                            }).catch(function () {});
                        }).catch(function (err) { console.error('FCM getToken failed:', err); });
                }

                if (Notification.permission === "granted") {
                    registerToken();
                } else if (Notification.permission === "default") {
                    Notification.requestPermission().then(function (perm) {
                        if (perm === "granted") registerToken();
                    });
                }

                // التاب مفتوح والمتصفح شايف الإشعار (data-only) — مش هنعرضه تاني
                // عشان الكارت الجامد بتاع الـ SignalR فوق أصلاً بيغطي الحالة دي
                messaging.onMessage(function () {});
            }).catch(function (err) { console.error('SW register failed:', err); });
        })();
        </script>
    }
</body>
</html>
