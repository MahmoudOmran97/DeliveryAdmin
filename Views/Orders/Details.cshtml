@model DeliveryAdmin.Models.OrderDto
@{
  ViewData["Title"] = "Order #" + Model.Id;
  string sc = "b-inactive";
  if(Model.Status=="Pending") sc="b-pending";
  else if(Model.Status=="Accepted") sc="b-accepted";
  else if(Model.Status=="Preparing") sc="b-preparing";
  else if(Model.Status=="ReadyForPickup") sc="b-ready";
  else if(Model.Status=="OnTheWay") sc="b-onway";
  else if(Model.Status=="Delivered") sc="b-delivered";
  else if(Model.Status=="Cancelled") sc="b-cancelled";
  else if(Model.Status=="Rejected") sc="b-rejected";

  var transitions = new string[0];
  if(Model.Status=="Pending") transitions = new[]{"Accepted","Rejected"};
  else if(Model.Status=="Accepted") transitions = new[]{"Preparing"};
  else if(Model.Status=="Preparing") transitions = new[]{"ReadyForPickup"};
  else if(Model.Status=="ReadyForPickup") transitions = new[]{"OnTheWay"};
  else if(Model.Status=="OnTheWay") transitions = new[]{"Delivered"};

  var hasEstimate = Model.EstimatedDeliveryMin.HasValue && Model.EstimatedDeliveryMax.HasValue;
  var estMin = Model.EstimatedDeliveryMin ?? 10;
  var estMax = Model.EstimatedDeliveryMax ?? 30;
}

<style>
    .estimate-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, var(--amber-bg), var(--bg2) 55%);
        border: 1px solid rgba(245,158,11,.25);
        border-radius: 16px;
        padding: 20px 22px;
        margin-bottom: 22px;
    }

        .estimate-card::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            background: linear-gradient(180deg, var(--amber), var(--accent));
        }

    .estimate-head {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 16px;
    }

    .estimate-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border-radius: 12px;
        background: var(--amber-bg);
        border: 1px solid rgba(245,158,11,.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .estimate-title {
        font-size: 15px;
        font-weight: 800;
        color: var(--text);
    }

    .estimate-subtitle {
        font-size: 12px;
        color: var(--text3);
        margin-top: 2px;
    }

    .estimate-range-display {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 10px;
    }

    .estimate-range-label {
        font-size: 12px;
        color: var(--text2);
    }

    .estimate-range-badge {
        display: flex;
        align-items: baseline;
        gap: 4px;
        font-family: var(--mono);
        font-weight: 800;
        font-size: 20px;
        color: var(--amber);
    }

    .estimate-range-dash {
        color: var(--text3);
        font-size: 14px;
    }

    .estimate-range-unit {
        font-size: 12px;
        font-weight: 600;
        color: var(--text2);
        margin-inline-start: 4px;
    }

    .estimate-bar {
        position: relative;
        height: 8px;
        border-radius: 99px;
        background: var(--bg4);
        margin-bottom: 18px;
        overflow: hidden;
    }

    .estimate-bar-fill {
        position: absolute;
        inset: 0;
        border-radius: 99px;
        background: linear-gradient(90deg, var(--amber), var(--accent));
    }

    .estimate-empty {
        font-size: 13px;
        color: var(--text3);
        background: var(--bg3);
        border: 1px dashed var(--border2);
        border-radius: 10px;
        padding: 12px 14px;
        margin-bottom: 16px;
    }

    .estimate-form {
        display: flex;
        align-items: end;
        gap: 12px;
        flex-wrap: wrap;
        padding-top: 14px;
        border-top: 1px solid rgba(245,158,11,.2);
    }

    .estimate-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .estimate-field label {
            font-size: 11px;
            color: var(--text3);
            font-weight: 600;
        }

        .estimate-field input {
            width: 120px;
        }

    .estimate-save {
        margin-inline-start: auto;
    }

    @@media (max-width: 600px) {
        .estimate-form {
            flex-direction: column;
            align-items: stretch;
        }

        .estimate-field input {
            width: 100%;
        }

        .estimate-save {
            margin-inline-start: 0;
        }
    }
</style>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;flex-wrap:wrap;gap:10px">
  <div style="display:flex;align-items:center;gap:14px">
    <span style="font-size:28px">📦</span>
    <div>
      <h2 style="font-size:20px;font-weight:800">Order #@Model.Id</h2>
      <div style="display:flex;align-items:center;gap:8px;margin-top:4px">
        <span class="badge @sc">@(Model.Status=="ReadyForPickup"?"Ready":Model.Status)</span>
        <span class="text-muted text-sm">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</span>
      </div>
    </div>
  </div>
  <div style="display:flex;gap:6px;flex-wrap:wrap">
    @foreach(var t in transitions)
    {
      string btnClass = (t=="Rejected"||t=="Cancelled") ? "btn-danger" : (t=="Delivered" ? "btn-success" : "btn-primary");
      <form method="post" action="/Orders/UpdateStatus/@Model.Id">
        <input type="hidden" name="status" value="@t">
        <button class="btn btn-sm @btnClass" type="submit">→ @t</button>
      </form>
    }
    <a class="btn btn-secondary btn-sm" asp-controller="Orders" asp-action="Index">← Back</a>
  </div>
</div>

<div class="estimate-card">
  <div class="estimate-head">
    <div class="estimate-icon">⏱️</div>
    <div>
      <div class="estimate-title">@Localizer["OrderEstimate_Title"]</div>
      <div class="estimate-subtitle">@Localizer["OrderEstimate_Subtitle"]</div>
    </div>
  </div>

  @if (hasEstimate)
  {
    <div class="estimate-range-display">
      <span class="estimate-range-label">@Localizer["OrderEstimate_RangeLabel"]</span>
      <div class="estimate-range-badge">
        <span>@estMin</span>
        <span class="estimate-range-dash">–</span>
        <span>@estMax</span>
        <span class="estimate-range-unit">@Localizer["OrderEstimate_Minutes"]</span>
      </div>
    </div>
    <div class="estimate-bar"><div class="estimate-bar-fill"></div></div>
  }
  else
  {
    <div class="estimate-empty">⏳ @Localizer["OrderEstimate_NotSetYet"]</div>
  }

  <form method="post" action="/Orders/UpdateEstimatedTime/@Model.Id" class="estimate-form">
    <div class="estimate-field">
      <label>@Localizer["OrderEstimate_Min"]</label>
      <input type="number" min="1" name="min" value="@estMin" class="form-control" required />
    </div>
    <div class="estimate-field">
      <label>@Localizer["OrderEstimate_Max"]</label>
      <input type="number" min="1" name="max" value="@estMax" class="form-control" required />
    </div>
    <button class="btn btn-warning estimate-save" type="submit">💾 @Localizer["OrderEstimate_Review"]</button>
  </form>
</div>

<div class="tabs-nav">
  <button type="button" class="tab-btn active" data-tab="info">📋 @Localizer["OrderChat_InfoTab"]</button>
  <button type="button" class="tab-btn" data-tab="chat">💬 @Localizer["OrderChat_Tab"]</button>
</div>

<div class="tab-pane" id="tab-info">
<div class="detail-grid">
  <div>
    <div class="detail-section" style="margin-bottom:16px">
      <div class="detail-section-title">Order Summary</div>
      <div class="detail-row"><span class="detail-key">Customer</span><span class="detail-val">@(Model.CustomerName??"–")</span></div>
      <div class="detail-row"><span class="detail-key">Restaurant</span><span class="detail-val">@(Model.Restaurant?.Name??Model.RestaurantName??"–")</span></div>
      <div class="detail-row"><span class="detail-key">Sub Total</span><span class="detail-val mono">@Model.SubTotal.ToString("N2") EGP</span></div>
      <div class="detail-row"><span class="detail-key">Delivery Fee</span><span class="detail-val mono">@Model.DeliveryFee.ToString("N2") EGP</span></div>
      @if(Model.Discount>0)
      {
        <div class="detail-row"><span class="detail-key">Discount</span><span class="detail-val mono" style="color:var(--green)">-@Model.Discount.ToString("N2") EGP</span></div>
      }
      <div class="detail-row">
        <span class="detail-key">Total</span>
        <span class="detail-val mono" style="font-size:16px;color:var(--accent);font-weight:800">@Model.TotalAmount.ToString("N2") EGP</span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Payment</span>
        <span>
          <span class="badge @(Model.PaymentMethod=="Cash"?"b-cash":"b-card")">@Model.PaymentMethod</span>
          &nbsp;
          <span class="badge @(Model.PaymentStatus=="Paid"?"b-paid":"b-pending-pay")">@Model.PaymentStatus</span>
        </span>
      </div>
    </div>
    <div class="detail-section">
      <div class="detail-section-title">Delivery Info</div>
      <div class="detail-row"><span class="detail-key">Address</span><span class="detail-val text-sm">@Model.DeliveryAddress</span></div>
      @if(!string.IsNullOrEmpty(Model.DeliveryNotes))
      {
        <div class="detail-row"><span class="detail-key">Notes</span><span class="detail-val text-sm">@Model.DeliveryNotes</span></div>
      }
      @if(Model.Driver!=null)
      {
        <div class="detail-row"><span class="detail-key">Driver</span><span class="detail-val">@Model.Driver.Name</span></div>
        <div class="detail-row"><span class="detail-key">Driver Phone</span><span class="detail-val mono">@(Model.Driver.Phone??"-")</span></div>
        <div class="detail-row"><span class="detail-key">Driver Rating</span><span class="detail-val">⭐ @Model.Driver.Rating.ToString("F1")</span></div>
      }
    </div>
  </div>
  <div class="detail-section">
    <div class="detail-section-title">Order Items (@(Model.Items?.Count??0))</div>
    @if(Model.Items!=null && Model.Items.Any())
    {
      @foreach(var item in Model.Items)
      {
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border)">
          <div>
            <div style="font-weight:600;font-size:13px">@item.ProductName</div>
            <div class="text-muted text-sm">x@(item.Quantity) &#64; @item.UnitPrice.ToString("N2") EGP</div>
            @if(!string.IsNullOrEmpty(item.Notes))
            {
              <div class="text-muted text-sm">Note: @item.Notes</div>
            }
          </div>
          <div class="mono" style="font-weight:700">@item.TotalPrice.ToString("N2") EGP</div>
        </div>
      }
      <div style="display:flex;justify-content:flex-end;padding-top:12px;font-weight:800;font-size:15px">
        Total: @Model.TotalAmount.ToString("N2") EGP
      </div>
    }
    else
    {
      <div class="empty"><div class="empty-icon">🛒</div><div>No items data available</div></div>
    }
  </div>
</div>
</div>

<div class="tab-pane" id="tab-chat" style="display:none">
  <div class="card">
    <div class="card-header">
      <div class="card-title">@Localizer["OrderChat_Title"]</div>
      <span class="badge b-inactive">@Localizer["PharmacyChats_ReadOnly"]</span>
    </div>
    @if (Model.Driver == null)
    {
      <div class="empty" style="padding:30px"><div class="empty-icon">🛵</div><div>@Localizer["OrderChat_NoDriver"]</div></div>
    }
    else
    {
      <div id="orderChatBox" style="padding:16px;max-height:480px;overflow-y:auto;display:flex;flex-direction:column;gap:10px"></div>
    }
  </div>
</div>

@section Scripts {
<script>
(function () {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const panes = { info: document.getElementById('tab-info'), chat: document.getElementById('tab-chat') };
    let chatLoaded = false;

    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            tabBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const target = btn.dataset.tab;
            Object.keys(panes).forEach(k => panes[k].style.display = k === target ? '' : 'none');
            if (target === 'chat' && !chatLoaded) {
                chatLoaded = true;
                loadOrderChat();
                setInterval(loadOrderChat, 5000);
            }
        });
    });

    function bubble(m) {
        const fromDriver = m.senderRole === 'Driver';
        const wrap = document.createElement('div');
        wrap.style.display = 'flex';
        wrap.style.justifyContent = fromDriver ? 'flex-end' : 'flex-start';
        const col = document.createElement('div');
        col.style.maxWidth = '70%';
        const label = document.createElement('div');
        label.style.fontSize = '10px';
        label.style.color = 'var(--text3)';
        label.style.margin = fromDriver ? '0 2px 3px 0' : '0 0 3px 2px';
        label.style.textAlign = fromDriver ? 'right' : 'left';
        label.textContent = fromDriver ? '@Localizer["OrderChat_Driver"]' : '@Localizer["OrderChat_Customer"]';
        const b = document.createElement('div');
        b.style.padding = '8px 12px';
        b.style.borderRadius = fromDriver ? '14px 14px 4px 14px' : '14px 14px 14px 4px';
        b.style.background = fromDriver ? '#1976D2' : 'rgba(255,255,255,.06)';
        b.style.color = fromDriver ? '#fff' : 'var(--text)';
        b.style.fontSize = '13px';
        b.textContent = m.message;
        col.appendChild(label);
        col.appendChild(b);
        wrap.appendChild(col);
        return wrap;
    }

    let lastCount = -1;
    async function loadOrderChat() {
        const box = document.getElementById('orderChatBox');
        if (!box) return;
        try {
            const res = await fetch(`/Orders/ChatMessages/@Model.Id`);
            if (!res.ok) return;
            const data = await res.json();
            if (data.length === lastCount) return;
            lastCount = data.length;
            box.innerHTML = '';
            if (data.length === 0) {
                box.innerHTML = '<div class="empty"><div class="empty-icon">💬</div><div>@Localizer["OrderChat_NoMessages"]</div></div>';
                return;
            }
            data.forEach(m => box.appendChild(bubble(m)));
            box.scrollTop = box.scrollHeight;
        } catch (e) { console.error(e); }
    }
})();
</script>
}
