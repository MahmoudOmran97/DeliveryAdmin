@model DeliveryAdmin.Models.AiSettingsDto
@{
    ViewData["Title"] = Localizer["AiSettings_Title"];
}
<div style="max-width:800px">
    <div class="card">
        <div class="card-header">
            <div class="card-title">🤖 @Localizer["AiSettings_Title"]</div>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" style="margin-bottom:12px">@TempData["Error"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" style="margin-bottom:12px">@TempData["Success"]</div>
            }

            <p class="text-muted" style="margin-bottom:16px">
                @Localizer["AiSettings_Description"]
            </p>

            <form method="post" asp-action="Save">
                <div class="form-group" style="margin-bottom:16px">
                    <label class="form-label" style="display:flex;align-items:center;gap:8px">
                        <input type="checkbox" name="isEnabled" value="true" checked="@Model.IsEnabled" style="width:18px;height:18px" />
                        @Localizer["AiSettings_IsEnabled"]
                    </label>
                    <input type="hidden" name="isEnabled" value="false" />
                </div>

                <div class="form-group" style="margin-bottom:16px">
                    <label class="form-label">@Localizer["AiSettings_ApiKey"]</label>
                    <input class="form-control" name="apiKey" type="password"
                           placeholder="@(Model.HasApiKey ? Model.ApiKeyMasked : "sk-or-v1-...")" autocomplete="off" />
                    <p class="text-muted text-sm" style="margin-top:4px">@Localizer["AiSettings_ApiKeyHint"]</p>
                </div>

                <div class="form-group" style="margin-bottom:16px">
                    <label class="form-label">@Localizer["AiSettings_Model"]</label>
                    <input class="form-control" name="model" value="@Model.Model" placeholder="openai/gpt-4o-mini" required />
                    <p class="text-muted text-sm" style="margin-top:4px">@Localizer["AiSettings_ModelHint"]</p>
                </div>

                <div class="form-group" style="margin-bottom:16px">
                    <label class="form-label">@Localizer["AiSettings_MaxTokens"]</label>
                    <input class="form-control" name="maxTokens" type="number" min="64" max="4096" value="@Model.MaxTokens" required />
                </div>

                <div class="form-group" style="margin-bottom:16px">
                    <label class="form-label">@Localizer["AiSettings_SystemPrompt"]</label>
                    <textarea class="form-control" name="systemPrompt" rows="8" style="font-family:inherit">@Model.SystemPrompt</textarea>
                    <p class="text-muted text-sm" style="margin-top:4px">@Localizer["AiSettings_SystemPromptHint"]</p>
                </div>

                @if (Model.UpdatedAt != default)
                {
                    <p class="text-muted text-sm" style="margin-bottom:12px">@Localizer["AiSettings_LastUpdated"] @Model.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                }

                <div style="display:flex;gap:8px">
                    <button class="btn btn-primary" type="submit">💾 @Localizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
