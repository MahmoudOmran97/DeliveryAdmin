@model DeliveryAdmin.Models.CreateCouponDto
@{
  ViewData["Title"] = "Edit Coupon";
  var rests = (List<DeliveryAdmin.Models.RestaurantDto>)ViewBag.Restaurants;
  var owner = ViewBag.OwnerCustomer as DeliveryAdmin.Models.UserDto;
}
<div style="max-width:700px">
<div class="card">
  <div class="card-header">
    <div class="card-title">✏️ @Localizer["Coupons_Edit"]</div>
    <a class="btn btn-secondary btn-sm" asp-action="Index">← @Localizer["Back"]</a>
  </div>
  <div class="card-body">
    @if (TempData["Error"] != null)
    {
      <div class="alert alert-danger" style="margin-bottom:12px">@TempData["Error"]</div>
    }
    <form method="post">
      <div class="form-grid">
        <div class="form-group"><label class="form-label">@Localizer["Coupons_Code"] *</label><input class="form-control" asp-for="Code" required></div>
        <div class="form-group"><label class="form-label">@Localizer["Coupons_Title"] *</label><input class="form-control" asp-for="Title" required></div>
        <div class="form-group form-full"><label class="form-label">@Localizer["Description"]</label><textarea class="form-control" asp-for="Description"></textarea></div>

        <div class="form-group">
          <label class="form-label">@Localizer["Coupons_DiscountType"]</label>
          <select class="form-control" asp-for="DiscountType">
            <option value="Fixed">@Localizer["Coupons_Fixed"]</option>
            <option value="Percentage">@Localizer["Coupons_Percentage"]</option>
          </select>
        </div>
        <div class="form-group"><label class="form-label">@Localizer["Coupons_DiscountValue"] *</label><input class="form-control" asp-for="DiscountValue" type="number" step="0.01" required></div>
        <div class="form-group"><label class="form-label">@Localizer["Coupons_MinOrder"]</label><input class="form-control" asp-for="MinOrderAmount" type="number" step="0.01"></div>
        <div class="form-group"><label class="form-label">@Localizer["Coupons_MaxDiscount"]</label><input class="form-control" asp-for="MaxDiscount" type="number" step="0.01"></div>

        <div class="form-group">
          <label class="form-label">@Localizer["Restaurant"]</label>
          <select class="form-control" asp-for="RestaurantId">
            <option value="">@Localizer["Coupons_AllRestaurants"]</option>
            @foreach (var r in rests) { <option value="@r.Id">@r.Name</option> }
          </select>
        </div>
        <div class="form-group"><label class="form-label">@Localizer["Coupons_UsageLimit"]</label><input class="form-control" asp-for="UsageLimit" type="number"></div>
        <div class="form-group"><label class="form-label">@Localizer["Coupons_Expires"]</label><input class="form-control" asp-for="ExpiresAt" type="date"></div>

        <div class="form-group form-full">
          <label class="form-label">@Localizer["Coupons_OwnerCustomer"]</label>
          <input type="hidden" asp-for="OwnerUserId" id="ownerUserIdInput" />
          <div id="ownerCustomerPicker">
            <div id="ownerCustomerSelected" style="@(owner != null ? "display:flex" : "display:none");align-items:center;gap:8px;padding:8px 12px;border:1px solid var(--border);border-radius:8px;background:var(--bg2)">
              <span id="ownerCustomerSelectedText" style="font-weight:600">@(owner != null ? owner.FullName + " — " + owner.Phone : "")</span>
              <button type="button" id="ownerCustomerClearBtn" class="btn btn-secondary btn-sm" style="margin-inline-start:auto">✕ @Localizer["Cancel"]</button>
            </div>
            <div id="ownerCustomerSearchBox" style="@(owner != null ? "display:none" : "display:block");position:relative">
              <input class="form-control" id="ownerCustomerSearchInput" type="text" autocomplete="off"
                     placeholder="@Localizer["Coupons_SearchCustomerPlaceholder"]" />
              <div id="ownerCustomerResults" style="display:none;position:absolute;z-index:20;top:100%;left:0;right:0;background:var(--bg1);border:1px solid var(--border);border-radius:8px;margin-top:4px;max-height:260px;overflow-y:auto;box-shadow:0 8px 20px rgba(0,0,0,.15)"></div>
            </div>
          </div>
          <div class="text-muted text-sm" style="margin-top:4px">@Localizer["Coupons_OwnerCustomerHint"]</div>
        </div>

        <div class="form-group">
          <label class="form-label">@Localizer["Status"]</label>
          <select class="form-control" asp-for="IsActive">
            <option value="true">@Localizer["Products_Available"]</option>
            <option value="false">@Localizer["Coupons_Disabled"]</option>
          </select>
        </div>
      </div>
      <div style="display:flex;gap:8px;margin-top:8px">
        <button class="btn btn-primary" type="submit">💾 @Localizer["SaveChanges"]</button>
        <a class="btn btn-secondary" asp-action="Index">@Localizer["Cancel"]</a>
      </div>
    </form>
  </div>
</div>
</div>

@section Scripts {
<script>
(function () {
    var hiddenInput = document.getElementById('ownerUserIdInput');
    var searchBox = document.getElementById('ownerCustomerSearchBox');
    var searchInput = document.getElementById('ownerCustomerSearchInput');
    var resultsBox = document.getElementById('ownerCustomerResults');
    var selectedBox = document.getElementById('ownerCustomerSelected');
    var selectedText = document.getElementById('ownerCustomerSelectedText');
    var clearBtn = document.getElementById('ownerCustomerClearBtn');
    var debounceTimer = null;

    function escapeHtml(s) {
        var d = document.createElement('div');
        d.textContent = s || '';
        return d.innerHTML;
    }

    function selectCustomer(id, fullName, phone) {
        hiddenInput.value = id;
        selectedText.textContent = fullName + (phone ? ' — ' + phone : '');
        selectedBox.style.display = 'flex';
        searchBox.style.display = 'none';
        resultsBox.style.display = 'none';
        searchInput.value = '';
    }

    function clearCustomer() {
        hiddenInput.value = '';
        selectedBox.style.display = 'none';
        searchBox.style.display = 'block';
        searchInput.value = '';
        resultsBox.style.display = 'none';
    }

    clearBtn.addEventListener('click', clearCustomer);

    searchInput.addEventListener('input', function () {
        var q = searchInput.value.trim();
        if (debounceTimer) clearTimeout(debounceTimer);
        if (q.length < 2) { resultsBox.style.display = 'none'; resultsBox.innerHTML = ''; return; }

        debounceTimer = setTimeout(function () {
            fetch('@Url.Action("SearchCustomers", "Coupons")?q=' + encodeURIComponent(q))
                .then(function (r) { return r.json(); })
                .then(function (list) {
                    if (!list || !list.length) {
                        resultsBox.innerHTML = '<div style="padding:10px 12px;color:var(--text3)">@Localizer["Coupons_NoCustomersFound"]</div>';
                        resultsBox.style.display = 'block';
                        return;
                    }
                    resultsBox.innerHTML = list.map(function (u) {
                        return '<div class="owner-customer-result" data-id="' + u.id + '" data-name="' + escapeHtml(u.fullName) + '" data-phone="' + escapeHtml(u.phone) + '" ' +
                            'style="padding:9px 12px;cursor:pointer;border-bottom:1px solid var(--border)">' +
                            '<div style="font-weight:600">' + escapeHtml(u.fullName) + '</div>' +
                            '<div class="text-muted text-sm">' + escapeHtml(u.phone) + (u.email ? ' • ' + escapeHtml(u.email) : '') + '</div>' +
                            '</div>';
                    }).join('');
                    resultsBox.style.display = 'block';

                    Array.prototype.forEach.call(resultsBox.querySelectorAll('.owner-customer-result'), function (el) {
                        el.addEventListener('mouseenter', function () { el.style.background = 'var(--bg2)'; });
                        el.addEventListener('mouseleave', function () { el.style.background = ''; });
                        el.addEventListener('click', function () {
                            selectCustomer(el.getAttribute('data-id'), el.getAttribute('data-name'), el.getAttribute('data-phone'));
                        });
                    });
                })
                .catch(function () { resultsBox.style.display = 'none'; });
        }, 300);
    });

    document.addEventListener('click', function (e) {
        if (!searchBox.contains(e.target)) resultsBox.style.display = 'none';
    });
})();
</script>
}
