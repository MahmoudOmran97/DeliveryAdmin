@model DeliveryAdmin.Models.SupportSessionDetailDto

<div class="card" style="margin-bottom:16px">
    <div class="card-header">
        <div class="card-title">💬 @Localizer["SupportChats_Customer"]: @Model.CustomerName</div>
        <a class="btn btn-secondary btn-sm" asp-action="Index">← @Localizer["SupportChats_Back"]</a>
    </div>
    <div style="padding:16px;display:flex;gap:24px;flex-wrap:wrap;align-items:center">
        <div>
            <div class="stat-label" style="margin-bottom:6px">@Localizer["Complaints_Status"]</div>
            @{
                var cls = Model.Status switch { "Escalated" => "b-active", "Closed" => "b-inactive", _ => "b-pending" };
            }
            <span class="badge @cls" id="statusBadge">@Model.Status</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.CustomerPhone))
        {
            <div>
                <div class="stat-label" style="margin-bottom:6px">@Localizer["Phone"]</div>
                <div>@Model.CustomerPhone</div>
            </div>
        }
        @if (Model.Status != "Closed")
        {
            <button id="closeBtn" class="btn btn-sm btn-secondary" style="margin-inline-start:auto">✅ @Localizer["SupportChats_Close"]</button>
        }
    </div>
</div>

<div class="card">
    <div class="card-header"><div class="card-title">@Localizer["SupportChats_Title"]</div></div>
    <div id="chatBox" style="padding:16px;max-height:480px;overflow-y:auto;display:flex;flex-direction:column;gap:10px"></div>
    <div style="padding:12px 16px;border-top:1px solid var(--border);display:flex;gap:8px">
        <input id="msgInput" class="filter-input" style="flex:1" placeholder="@Localizer["SupportChats_TypeMessage"]" />
        <button id="sendBtn" class="btn btn-primary btn-sm">@Localizer["SupportChats_SendReply"]</button>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const sessionId = @Model.Id;
    const chatBox = document.getElementById('chatBox');
    const msgInput = document.getElementById('msgInput');
    const sendBtn = document.getElementById('sendBtn');
    const closeBtn = document.getElementById('closeBtn');
    const statusBadge = document.getElementById('statusBadge');

    function bubble(m) {
        const mine = m.senderRole === 'Admin';
        const isAi = m.senderRole === 'AI';
        const wrap = document.createElement('div');
        wrap.style.display = 'flex';
        wrap.style.justifyContent = mine ? 'flex-end' : 'flex-start';
        const col = document.createElement('div');
        col.style.maxWidth = '70%';
        const label = document.createElement('div');
        label.style.fontSize = '10px';
        label.style.color = 'var(--text3)';
        label.style.margin = mine ? '0 2px 3px 0' : '0 0 3px 2px';
        label.textContent = mine ? 'Admin' : (isAi ? '🤖 AI' : '@Localizer["Complaints_Customer"]');
        const b = document.createElement('div');
        b.style.padding = '8px 12px';
        b.style.borderRadius = mine ? '14px 14px 4px 14px' : '14px 14px 14px 4px';
        b.style.background = mine ? '#1976D2' : (isAi ? '#37474F' : 'rgba(255,255,255,.06)');
        b.style.color = '#fff';
        if (!mine && !isAi) b.style.color = 'var(--text)';
        b.style.fontSize = '13px';
        b.style.whiteSpace = 'pre-wrap';
        b.textContent = m.message;
        col.appendChild(label);
        col.appendChild(b);
        wrap.appendChild(col);
        return wrap;
    }

    let lastCount = -1;
    async function loadMessages() {
        try {
            const res = await fetch(`/SupportChats/Messages?id=${sessionId}`);
            if (!res.ok) return;
            const data = await res.json();
            if (data.length === lastCount) return;
            lastCount = data.length;
            chatBox.innerHTML = '';
            data.forEach(m => chatBox.appendChild(bubble(m)));
            chatBox.scrollTop = chatBox.scrollHeight;
        } catch (e) { console.error(e); }
    }

    async function send() {
        const text = msgInput.value.trim();
        if (!text) return;
        msgInput.value = '';
        await fetch(`/SupportChats/SendMessage?id=${sessionId}&message=${encodeURIComponent(text)}`, { method: 'POST' });
        if (statusBadge) { statusBadge.textContent = 'Escalated'; statusBadge.className = 'badge b-active'; }
        lastCount = -1;
        await loadMessages();
    }

    sendBtn.addEventListener('click', send);
    msgInput.addEventListener('keydown', e => { if (e.key === 'Enter') send(); });

    if (closeBtn) {
        closeBtn.addEventListener('click', async () => {
            if (!confirm('@Localizer["SupportChats_Close"]?')) return;
            await fetch(`/SupportChats/Close?id=${sessionId}`, { method: 'POST' });
            window.location.href = '/SupportChats/Index';
        });
    }

    loadMessages();
    setInterval(loadMessages, 4000);
})();
</script>
}
