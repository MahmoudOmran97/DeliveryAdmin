@model IEnumerable<DeliveryAdmin.Models.SiteLinkAdminDto>
@using DeliveryAdmin.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["SiteLinks_Title"];
}

<style>
    .site-links-grid {
        display: grid;
        gap: 16px;
    }

    .site-link-card {
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--bg2);
        padding: 20px;
        transition: border-color .15s;
    }

        .site-link-card:hover {
            border-color: var(--border2, rgba(255,255,255,0.15));
        }

    .site-link-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
    }

    .site-link-key {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        color: var(--text);
    }

    .site-link-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg3);
        font-size: 20px;
        border: 1px solid var(--border);
    }

    .site-link-fields {
        display: grid;
        grid-template-columns: 1fr 2fr 120px 100px;
        gap: 14px;
        align-items: end;
    }

    .site-link-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
    }

    .site-link-active {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--text2);
        cursor: pointer;
    }

        .site-link-active input {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

    @@media (max-width: 900px) {
        .site-link-fields {
            grid-template-columns: 1fr 1fr;
        }

            .site-link-fields .wide-field {
                grid-column: 1 / -1;
            }
    }

    @@media (max-width: 600px) {
        .site-link-fields {
            grid-template-columns: 1fr;
        }

            .site-link-fields .wide-field {
                grid-column: auto;
            }

        .site-link-head, .site-link-actions {
            flex-direction: column;
            align-items: flex-start;
        }
    }</style>

<div style="max-width: 1100px;">
    <div class="card">
        <div class="card-header">
            <div class="card-title">🔗 @Localizer["SiteLinks_Title"]</div>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" style="margin-bottom: 16px;">
                    <span>✅</span> @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" style="margin-bottom: 16px;">
                    <span>❌</span> @TempData["Error"]
                </div>
            }

            <p class="text-muted" style="margin: 0 0 20px 0;">
                @Localizer["SiteLinks_Description"]
            </p>

            @if (!Model.Any())
            {
                <div class="empty">
                    <div class="empty-icon">🔗</div>
                    @Localizer["SiteLinks_Empty"]
                </div>
            }
            else
            {
                <div class="site-links-grid">
                    @foreach (var link in Model.OrderBy(x => x.SortOrder))
                    {
                        <form class="site-link-card" method="post" asp-action="Save">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="key" value="@link.Key" />

                            <div class="site-link-head">
                                <div class="site-link-key">
                                    <span class="site-link-icon">@(string.IsNullOrWhiteSpace(link.Icon) ? "🔗" : link.Icon)</span>
                                    <div>
                                        <div style="font-size: 14px; font-weight: 700;">@link.Title</div>
                                        <div class="mono text-muted" style="font-size: 11px;">@link.Key</div>
                                    </div>
                                </div>
                                <span class="text-muted text-sm mono">@Localizer["SiteLinks_LastUpdated"] @link.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>

                            <div class="site-link-fields">
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label class="form-label">@Localizer["SiteLinks_TitleField"]</label>
                                    <input class="form-control" name="title" value="@link.Title" maxlength="120" required />
                                </div>
                                <div class="form-group wide-field" style="margin-bottom: 0;">
                                    <label class="form-label">@Localizer["SiteLinks_Url"]</label>
                                    <input class="form-control" name="url" type="url" value="@link.Url" placeholder="https://..." required />
                                </div>
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label class="form-label">@Localizer["SiteLinks_Icon"]</label>
                                    <input class="form-control" name="icon" value="@link.Icon" maxlength="20" placeholder="🔗" />
                                </div>
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label class="form-label">@Localizer["SiteLinks_Order"]</label>
                                    <input class="form-control" name="sortOrder" type="number" min="0" value="@link.SortOrder" />
                                </div>
                            </div>

                            <div class="site-link-actions">
                                <label class="site-link-active">
                                    <input type="checkbox" name="isActive" value="true" checked="@link.IsActive" />
                                    <input type="hidden" name="isActive" value="false" />
                                    @Localizer["SiteLinks_Active"]
                                </label>
                                <button class="btn btn-primary" type="submit">
                                    <span>💾</span> @Localizer["SiteLinks_Save"]
                                </button>
                            </div>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
</div>
