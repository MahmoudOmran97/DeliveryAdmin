@model List<DeliveryAdmin.Models.StoreDriverDto>
@using System.Globalization
@{
  var online = Model.Count(d => d.IsOnline);
  var withActiveOrder = Model.Count(d => d.CurrentOrderId != null);
  double storeLat = ViewBag.StoreLat ?? 0;
  double storeLng = ViewBag.StoreLng ?? 0;
  string storeName = ViewBag.StoreName ?? "";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div style="display:flex;justify-content:flex-end;margin-bottom:12px">
  <button type="button" id="openStoreMapBtn" class="btn btn-primary btn-sm">@Localizer["LiveMap_StoreOpenBtn"]</button>
</div>

<div class="stat-row">
  <div class="stat-box"><div class="stat-label">@Localizer["MyDrivers_Total"]</div><div class="stat-val">@Model.Count</div></div>
  <div class="stat-box"><div class="stat-label">@Localizer["MyDrivers_Online"]</div><div class="stat-val" style="color:var(--green)">@online</div></div>
  <div class="stat-box"><div class="stat-label">@Localizer["MyDrivers_Active"]</div><div class="stat-val" style="color:var(--accent)">@withActiveOrder</div></div>
  <div class="stat-box"><div class="stat-label">@Localizer["MyDrivers_Offline"]</div><div class="stat-val" style="color:var(--text3)">@(Model.Count - online)</div></div>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">🛵 @Localizer["Nav_MyDrivers"] <span class="text-muted text-sm">(@Model.Count)</span></div>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>@Localizer["MyDrivers_Driver"]</th>
          <th>@Localizer["MyDrivers_Vehicle"]</th>
          <th>@Localizer["MyDrivers_Phone"]</th>
          <th>@Localizer["MyDrivers_Rating"]</th>
          <th>@Localizer["MyDrivers_DeliveriesCount"]</th>
          <th>@Localizer["MyDrivers_Status"]</th>
          <th>@Localizer["MyDrivers_CurrentOrder"]</th>
        </tr>
      </thead>
      <tbody>
        @if (!Model.Any())
        {
          <tr><td colspan="7"><div class="empty"><div class="empty-icon">🛵</div><div>@Localizer["MyDrivers_NoDrivers"]</div></div></td></tr>
        }
        @foreach (var d in Model)
        {
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:8px">
                <div style="width:32px;height:32px;border-radius:50%;background:var(--bg4);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--text2)">@((d.UserName ?? d.FullName)?.FirstOrDefault().ToString().ToUpper() ?? "D")</div>
                <div style="font-weight:600">@(d.UserName ?? d.FullName ?? Localizer["MyDrivers_DriverPrefix"] + d.Id)</div>
              </div>
            </td>
            <td>@d.VehicleType <span class="mono text-muted text-sm">@d.LicensePlate</span></td>
            <td class="mono">@(d.Phone ?? "–")</td>
            <td><span class="stars">⭐</span> @d.Rating.ToString("F1")</td>
            <td class="mono" style="font-weight:600">@d.DeliveriesForThisStore</td>
            <td><span class="badge @(d.IsOnline ? "b-online" : "b-offline")">@(d.IsOnline ? "Online" : Localizer["MyDrivers_Offline"])</span></td>
            <td>
              @if (d.CurrentOrderId != null)
              {
                <a class="badge b-onway" asp-controller="MyStore" asp-action="Orders" style="text-decoration:none">#@d.CurrentOrderId · @d.CurrentOrderStatus</a>
              }
              else
              {
                <span class="text-muted text-sm">@Localizer["MyDrivers_NoActiveOrder"]</span>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@* ══════════════════════════════════════════════════════════
   مودال خريطة السواقين حوالين المحل — Leaflet + OpenStreetMap
   ══════════════════════════════════════════════════════════ *@
<div id="storeMapOverlay" class="live-map-overlay" style="display:none">
  <div class="live-map-modal" style="max-width:900px;height:78vh">
    <div class="live-map-header">
      <div class="card-title">🗺️ @storeName</div>
      <button type="button" class="live-map-close" id="storeMapCloseBtn">✕</button>
    </div>
    <div class="live-map-body">
      <div class="live-map-canvas-wrap"><div id="storeMapCanvas"></div></div>
      <div class="live-map-sidebar">
        <div class="lm-list" id="storeMapList"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .live-map-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,.65);
    display: flex; align-items: center; justify-content: center;
    z-index: 1000; padding: 16px;
  }
  .live-map-modal {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 14px; width: 100%; display: flex; flex-direction: column; overflow: hidden;
  }
  .live-map-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; border-bottom: 1px solid var(--border); }
  .live-map-close { background: none; border: none; color: var(--text2); font-size: 18px; cursor: pointer; }
  .live-map-body { flex: 1; display: flex; min-height: 0; }
  .live-map-canvas-wrap { position: relative; flex: 1; min-width: 0; }
  #storeMapCanvas { width: 100%; height: 100%; }
  .live-map-sidebar { width: 260px; flex-shrink: 0; border-inline-start: 1px solid var(--border); overflow-y: auto; }
  .lm-list { padding: 8px; }
  .lm-item { display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 8px; cursor: pointer; margin-bottom: 4px; }
  .lm-item:hover { background: var(--bg4); }
  .lm-item-icon { width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 14px; }
  .lm-item-name { font-weight: 600; font-size: 12.5px; }
  .lm-item-sub { font-size: 11px; color: var(--text2); }
  .leaflet-pane, .leaflet-control { z-index: 1; }
  .lm-driver-icon, .lm-store-icon { display: flex; align-items: center; justify-content: center; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,.4); font-size: 15px; color: #fff; }
</style>

@section Scripts {
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    (function () {
      const storeLat = @storeLat.ToString(CultureInfo.InvariantCulture);
      const storeLng = @storeLng.ToString(CultureInfo.InvariantCulture);
      const drivers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
          Model.Where(d => d.CurrentLatitude.HasValue && d.CurrentLongitude.HasValue)
               .Select(d => new {
                   id = d.Id,
                   name = d.UserName ?? d.FullName ?? ("#" + d.Id),
                   phone = d.Phone,
                   vehicleType = d.VehicleType,
                   isOnline = d.IsOnline,
                   isAvailable = d.IsAvailable,
                   currentOrderId = d.CurrentOrderId,
                   lat = d.CurrentLatitude,
                   lng = d.CurrentLongitude
               })));

      const overlay = document.getElementById('storeMapOverlay');
      const openBtn = document.getElementById('openStoreMapBtn');
      const closeBtn = document.getElementById('storeMapCloseBtn');
      const listEl = document.getElementById('storeMapList');
      let map, mapReady = false;

      function haversineKm(lat1, lng1, lat2, lng2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLng = (lng2 - lng1) * Math.PI / 180;
        const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * Math.PI / 180) *
                  Math.cos(lat2 * Math.PI / 180) * Math.sin(dLng / 2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }

      function driverIcon(d) {
        const color = !d.isOnline ? '#9ca3af' : (d.isAvailable ? '#22c55e' : '#3b82f6');
        return L.divIcon({ className: '', html: `<div class="lm-driver-icon" style="width:28px;height:28px;background:${color}">🛵</div>`, iconSize: [28, 28], iconAnchor: [14, 14] });
      }

      function ensureMap() {
        if (mapReady) return;
        map = L.map('storeMapCanvas').setView([storeLat, storeLng], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap contributors' }).addTo(map);

        L.marker([storeLat, storeLng], {
          icon: L.divIcon({ className: '', html: '<div class="lm-store-icon" style="width:34px;height:34px;background:#f97316">🏪</div>', iconSize: [34, 34], iconAnchor: [17, 17] }),
          zIndexOffset: 1000
        }).addTo(map).bindPopup('@storeName').openPopup();

        const items = drivers.map(d => {
          const distKm = haversineKm(storeLat, storeLng, d.lat, d.lng);
          const marker = L.marker([d.lat, d.lng], { icon: driverIcon(d) }).addTo(map)
            .bindPopup(`<b>${d.name}</b><br>${d.vehicleType || ''}<br>` +
              `${d.isOnline ? (d.isAvailable ? '🟢' : '🔵 طلب #' + (d.currentOrderId || '')) : '⚪'}<br>📍 ${distKm.toFixed(1)} كم`);
          return { ...d, distKm, marker };
        }).sort((a, b) => a.distKm - b.distKm);

        listEl.innerHTML = items.length ? '' : '<div class="text-muted text-sm" style="padding:12px">—</div>';
        items.forEach(d => {
          const color = !d.isOnline ? '#9ca3af' : (d.isAvailable ? '#22c55e' : '#3b82f6');
          const row = document.createElement('div');
          row.className = 'lm-item';
          row.innerHTML = `<div class="lm-item-icon" style="background:${color}22;color:${color}">🛵</div>
            <div style="min-width:0;flex:1">
              <div class="lm-item-name">${d.name}</div>
              <div class="lm-item-sub">${d.distKm.toFixed(1)} كم${d.currentOrderId ? ' · #' + d.currentOrderId : ''}</div>
            </div>`;
          row.addEventListener('click', () => { map.setView(d.marker.getLatLng(), 16); d.marker.openPopup(); });
          listEl.appendChild(row);
        });

        mapReady = true;
      }

      openBtn.addEventListener('click', () => {
        overlay.style.display = 'flex';
        ensureMap();
        setTimeout(() => map.invalidateSize(), 50);
      });
      closeBtn.addEventListener('click', () => overlay.style.display = 'none');
      overlay.addEventListener('click', e => { if (e.target === overlay) overlay.style.display = 'none'; });
    })();
  </script>
}
