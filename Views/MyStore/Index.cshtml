@model DeliveryAdmin.Models.RestaurantDto
@{
    var storeType = (string)(ViewBag.StoreType ?? "Restaurant");
    var typeInfo = DeliveryAdmin.Models.StoreTypes.All.FirstOrDefault(t => t.Value == storeType);
}

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;flex-wrap:wrap;gap:10px">
  <div>
    <h2 style="font-size:18px;font-weight:800">@typeInfo.Emoji @Model.Name</h2>
    <div class="text-muted text-sm">@Localizer["Nav_Orders"]: <a asp-action="Orders">@Localizer["Nav_Orders"]</a> — @Localizer["Nav_Products"]: <a asp-action="Menu">@Localizer["Nav_Products"]</a></div>
  </div>
  <form method="post" asp-action="ToggleOpen">
    @if (Model.IsOpen)
    {
      <button class="btn btn-warning" type="submit">🔴 قفل المحل</button>
    }
    else
    {
      <button class="btn btn-success" type="submit">🟢 فتح المحل</button>
    }
  </form>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:18px">
  <div class="card"><div style="padding:16px">
    <div class="text-muted text-sm">@Localizer["Status"]</div>
    <div style="margin-top:6px"><span class="badge @(Model.IsOpen ? "b-active" : "b-inactive")">@(Model.IsOpen ? "مفتوح" : "مقفول")</span></div>
  </div></div>
  <div class="card"><div style="padding:16px">
    <div class="text-muted text-sm">⭐ التقييم</div>
    <div style="font-size:20px;font-weight:800;margin-top:4px">@Model.Rating.ToString("N1") <span class="text-muted text-sm">(@Model.TotalRatings)</span></div>
  </div></div>
  <div class="card"><div style="padding:16px">
    <div class="text-muted text-sm">🚚 رسوم التوصيل</div>
    <div style="font-size:20px;font-weight:800;margin-top:4px">@Model.DeliveryFee.ToString("N0") @Localizer["Currency"]</div>
  </div></div>
  <div class="card"><div style="padding:16px">
    <div class="text-muted text-sm">💰 أقل قيمة طلب</div>
    <div style="font-size:20px;font-weight:800;margin-top:4px">@Model.MinOrderAmount.ToString("N0") @Localizer["Currency"]</div>
  </div></div>
</div>

<div class="card">
  <div class="card-header"><div class="card-title">✏️ بيانات المحل</div></div>
  <div class="card-body">
    <form method="post" asp-action="UpdateInfo">
      <div class="form-grid">
        <div class="form-group"><label class="form-label">اسم المحل *</label><input class="form-control" name="Name" value="@Model.Name" required></div>
        <div class="form-group"><label class="form-label">التليفون</label><input class="form-control" name="Phone" value="@Model.Phone"></div>
        <div class="form-group form-full"><label class="form-label">العنوان *</label><input class="form-control" name="Address" value="@Model.Address" required></div>
        <div class="form-group form-full"><label class="form-label">الوصف</label><textarea class="form-control" name="Description">@Model.Description</textarea></div>
        <div class="form-group"><label class="form-label">رسوم التوصيل (أول 3 كم)</label><input class="form-control" name="DeliveryFee" type="number" step="0.01" value="@Model.DeliveryFee"></div>
        <div class="form-group"><label class="form-label">أقل قيمة طلب</label><input class="form-control" name="MinOrderAmount" type="number" step="0.01" value="@Model.MinOrderAmount"></div>
        <div class="form-group"><label class="form-label">مدة التحضير التقديرية (دقيقة)</label><input class="form-control" name="EstimatedTime" type="number" value="@Model.EstimatedTime"></div>
        <input type="hidden" name="StoreType" value="@Model.StoreType" />
        <input type="hidden" name="IsOpen" value="@Model.IsOpen.ToString().ToLower()" />
        <div class="form-group"><label class="form-label">Latitude</label><input class="form-control" name="Latitude" type="number" step="any" value="@Model.Latitude"></div>
        <div class="form-group"><label class="form-label">Longitude</label><input class="form-control" name="Longitude" type="number" step="any" value="@Model.Longitude"></div>
        <div class="form-group form-full"><label class="form-label">رابط صورة اللوجو</label><input class="form-control" name="ImageUrl" value="@Model.ImageUrl"></div>
        <div class="form-group form-full"><label class="form-label">رابط صورة الغلاف</label><input class="form-control" name="CoverImageUrl" value="@Model.CoverImageUrl"></div>
      </div>
      <div style="display:flex;gap:8px;margin-top:14px">
        <button class="btn btn-primary" type="submit">💾 حفظ التعديلات</button>
      </div>
    </form>
  </div>
</div>
