@model List<DeliveryAdmin.Models.CategoryDto>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;flex-wrap:wrap;gap:10px">
  <div>
    <h2 style="font-size:18px;font-weight:800">📂 @Localizer["Nav_MyMenu"]</h2>
    <div class="text-muted text-sm">@Localizer["Menu_Subtitle"]</div>
  </div>
  <div style="display:flex;gap:8px">
    <a class="btn btn-primary" asp-action="CreateCategory">➕ @Localizer["Cat_Add"]</a>
    <a class="btn btn-secondary" asp-action="Index">@Localizer["Menu_BackToStore"]</a>
  </div>
</div>

@if (TempData["Success"] != null)
{
  <div class="alert alert-success" style="margin-bottom:16px">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
  <div class="alert alert-danger" style="margin-bottom:16px">@TempData["Error"]</div>
}

@if (!Model.Any())
{
  <div class="card">
    <div class="empty">
      <div class="empty-icon">📂</div>
      <div>@Localizer["Menu_NoCategories"]</div>
      <a class="btn btn-primary" asp-action="CreateCategory" style="margin-top:12px">➕ @Localizer["Cat_Add"]</a>
    </div>
  </div>
}
else
{
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px">
    @foreach (var c in Model)
    {
      <div class="card">
        <div style="padding:16px">
          <a href="@Url.Action("MenuProducts", new { categoryId = c.Id })" style="text-decoration:none;color:inherit">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
              @if (!string.IsNullOrEmpty(c.ImageUrl))
              {
                <img src="@c.ImageUrl" style="width:44px;height:44px;border-radius:10px;object-fit:cover" alt="">
              }
              else
              {
                <div style="width:44px;height:44px;border-radius:10px;background:var(--bg4);display:flex;align-items:center;justify-content:center;font-size:20px">📂</div>
              }
              <div>
                <div style="font-weight:700;font-size:14px">@c.Name</div>
              </div>
            </div>
            <div style="padding-top:10px;border-top:1px solid var(--border)">
              <div style="font-size:20px;font-weight:800">@c.ProductCount</div>
              <div class="text-muted" style="font-size:10px;text-transform:uppercase;font-weight:700">@Localizer["Menu_ProductWord"]</div>
            </div>
          </a>
          <div style="display:flex;gap:6px;margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
            <a class="btn btn-secondary btn-sm" asp-action="EditCategory" asp-route-id="@c.Id">✏️ @Localizer["Edit"]</a>
            <form method="post" asp-action="DeleteCategory" asp-route-id="@c.Id" onsubmit="return confirm('@Localizer["Cat_ConfirmDelete"]')" style="display:inline">
              <button type="submit" class="btn btn-danger btn-sm">🗑 @Localizer["Delete"]</button>
            </form>
          </div>
        </div>
      </div>
    }
  </div>
}
