@model DeliveryAdmin.Models.CreateProductDto
<div style="max-width:700px">
  <div class="card">
    <div class="card-header">
      <div class="card-title">➕ @Localizer["Products_Add"] — @ViewBag.CategoryName</div>
      <a class="btn btn-secondary btn-sm" asp-action="MenuProducts" asp-route-categoryId="@ViewBag.CategoryId">← @Localizer["Cancel"]</a>
    </div>
    <div class="card-body">
      @if (TempData["Error"] != null)
      {
        <div class="alert alert-danger" style="margin-bottom:14px">@TempData["Error"]</div>
      }
      <form method="post">
        <input type="hidden" asp-for="CategoryId" />
        <div class="form-grid">
          <div class="form-group form-full">
            <label class="form-label">@Localizer["Products_Name"] *</label>
            <input class="form-control" asp-for="Name" required />
          </div>
          <div class="form-group form-full">
            <label class="form-label">@Localizer["Products_Description"]</label>
            <textarea class="form-control" asp-for="Description"></textarea>
          </div>
          <div class="form-group">
            <label class="form-label">@Localizer["Products_Price"] *</label>
            <input class="form-control" asp-for="Price" type="number" step="0.01" required />
          </div>
          <div class="form-group">
            <label class="form-label">@Localizer["Products_DiscountedPrice"]</label>
            <input class="form-control" asp-for="DiscountedPrice" type="number" step="0.01" />
          </div>
          <div class="form-group">
            <label class="form-label">@Localizer["Products_PrepTime"]</label>
            <input class="form-control" asp-for="PreparationTime" type="number" value="15" />
          </div>
          <div class="form-group">
            <label class="form-label">@Localizer["Products_Calories"]</label>
            <input class="form-control" asp-for="Calories" type="number" />
          </div>
          <div class="form-group form-full">
            <label class="form-label">@Localizer["Products_ImageUrl"]</label>
            <input class="form-control" asp-for="ImageUrl" placeholder="https://..." />
          </div>
          <div class="form-group form-full">
            <label class="form-label">📏 مقاسات/خيارات إضافية (اختياري) — زي صغير/وسط/كبير أو شريط/علبة</label>
            <div id="variantsList"></div>
            <button type="button" class="btn btn-secondary btn-sm" onclick="addVariantRow()" style="margin-top:6px">+ إضافة خيار</button>
            <input type="hidden" name="variantsJson" id="variantsJson">
            <div id="variantsWarning" style="display:none;color:#dc3545;margin-top:6px;font-size:.85rem"></div>
          </div>
        </div>
        <div style="display:flex;gap:8px;margin-top:8px">
          <button class="btn btn-primary" type="submit">💾 @Localizer["Save"]</button>
          <a class="btn btn-secondary" asp-action="MenuProducts" asp-route-categoryId="@ViewBag.CategoryId">@Localizer["Cancel"]</a>
        </div>
      </form>
    </div>
  </div>
</div>
@section Scripts {
<script>
let variantRowCount = 0;
function addVariantRow(name = '', price = '') {
  const list = document.getElementById('variantsList');
  const rowId = 'vrow_' + (variantRowCount++);
  const row = document.createElement('div');
  row.id = rowId;
  row.dataset.rowMarker = '1';
  row.style = 'display:flex;gap:8px;margin-top:6px;align-items:center';
  row.innerHTML = `
    <input class="form-control vname" placeholder="مثال: كبير / علبة" value="${name}" style="flex:2">
    <input class="form-control vprice" type="number" step="0.01" placeholder="السعر" value="${price}" style="flex:1">
    <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('${rowId}').remove()">✕</button>
  `;
  list.appendChild(row);
}
function parsePrice(raw) {
  if (raw === null || raw === undefined) return NaN;
  return parseFloat(String(raw).trim().replace(',', '.'));
}
function collectVariants() {
  const rows = document.querySelectorAll('#variantsList > div[data-row-marker]');
  const variants = [];
  const problems = [];
  rows.forEach((row, i) => {
    const nameInput = row.querySelector('.vname');
    const priceInput = row.querySelector('.vprice');
    if (!nameInput || !priceInput) { problems.push(`صف ${i + 1}: فيه حقول ناقصة`); return; }
    const name = nameInput.value.trim();
    const priceRaw = priceInput.value;
    const price = parsePrice(priceRaw);
    if (!name && !priceRaw) return;
    if (!name || isNaN(price)) { problems.push(`صف ${i + 1}: "${name || '(بدون اسم)'}" محتاج اسم وسعر صحيح`); return; }
    variants.push({ name: name, price: price, sortOrder: i });
  });
  return { variants, problems, totalRows: rows.length };
}
document.querySelector('form').addEventListener('submit', function (e) {
  const { variants, problems, totalRows } = collectVariants();
  const warningEl = document.getElementById('variantsWarning');
  if (problems.length > 0) {
    e.preventDefault();
    warningEl.style.display = 'block';
    warningEl.textContent = '⚠️ ' + problems.join(' | ');
    return;
  }
  if (totalRows > 0 && variants.length === 0) {
    e.preventDefault();
    warningEl.style.display = 'block';
    warningEl.textContent = '⚠️ مقدرتش أقرأ الخيارات اللي دخلتها، راجعها تاني.';
    return;
  }
  warningEl.style.display = 'none';
  document.getElementById('variantsJson').value = JSON.stringify(variants);
});
</script>
}
