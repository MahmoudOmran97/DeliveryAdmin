@model DeliveryAdmin.Models.UpdateDeliverySettingsDto
@{ ViewData["Title"] = "Delivery Fee Settings"; }
<div style="max-width:700px">
<div class="card">
  <div class="card-header">
    <div class="card-title">🚚 Delivery Fee Settings</div>
  </div>
  <div class="card-body">
    @if (TempData["Error"] != null)
    {
      <div class="alert alert-danger" style="margin-bottom:12px">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
      <div class="alert alert-success" style="margin-bottom:12px">@TempData["Success"]</div>
    }

    <p class="text-muted" style="margin-bottom:16px">
      كل محل ليه سعر توصيل أساسي بيتحدد من صفحة المحل، وبيتحصّل زي ما هو
      طول ما مسافة العميل عن المحل أقل من أو تساوي "المسافة المجانية" اللي
      تحددها هنا. أي مسافة زيادة عن كده، بيتضاف عليها "سعر الكيلومتر
      الإضافي" عن كل كيلومتر (أو جزء منه).
      <br />
      مثال: لو المسافة المجانية 3 كم وسعر الكيلومتر الإضافي 10 جنيه، وسعر
      المحل الأساسي 20 جنيه: عميل على بعد 3.5 كم هيدفع 30 جنيه توصيل.
    </p>

    <form method="post">
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">المسافة المجانية (كم)</label>
          <input class="form-control" asp-for="FreeRadiusKm" type="number" step="0.1" min="0" required>
        </div>
        <div class="form-group">
          <label class="form-label">سعر الكيلومتر الإضافي (جنيه)</label>
          <input class="form-control" asp-for="ExtraFeePerKm" type="number" step="0.5" min="0" required>
        </div>
      </div>

      @if (ViewBag.UpdatedAt != null)
      {
        <p class="text-muted text-sm" style="margin-top:4px">آخر تحديث: @(((DateTime)ViewBag.UpdatedAt).ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</p>
      }

      <div style="display:flex;gap:8px;margin-top:12px">
        <button class="btn btn-primary" type="submit">💾 حفظ التعديلات</button>
      </div>
    </form>
  </div>
</div>
</div>
