@model List<DeliveryAdmin.Models.RatingDto>
@{
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    double avgRestaurant = ViewBag.AvgRestaurant;
    double avgFood = ViewBag.AvgFood;
}

<div class="stat-row">
    <div class="stat-box"><div class="stat-label">@Localizer["MyRatings_Total"]</div><div class="stat-val">@ViewBag.Total</div></div>
    <div class="stat-box"><div class="stat-label">@Localizer["MyRatings_AvgStore"]</div><div class="stat-val" style="color:var(--amber)">@avgRestaurant.ToString("F1") ⭐</div></div>
    <div class="stat-box"><div class="stat-label">@Localizer["MyRatings_AvgFood"]</div><div class="stat-val" style="color:var(--amber)">@avgFood.ToString("F1") ⭐</div></div>
</div>

<div class="card">
    <div class="card-header">
        <div class="card-title">@Localizer["MyRatings_Title"]</div>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>#ID</th>
                    <th>@Localizer["MyRatings_Customer"]</th>
                    <th>@Localizer["MyRatings_StoreRating"]</th>
                    <th>@Localizer["MyRatings_FoodRating"]</th>
                    <th>@Localizer["MyRatings_Driver"]</th>
                    <th>@Localizer["MyRatings_Comment"]</th>
                    <th>@Localizer["MyRatings_Date"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7"><div class="empty"><div class="empty-icon">⭐</div><div>@Localizer["MyRatings_NoRatings"]</div></div></td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="mono">#@r.Id</td>
                        <td style="font-weight:500">@(r.CustomerName ?? "-")</td>
                        <td><span class="stars">@("⭐".PadRight(r.RestaurantRating, '⭐')[..r.RestaurantRating])</span> @r.RestaurantRating/5</td>
                        <td>@(r.FoodRating.HasValue? r.FoodRating + "/5" : "-")</td>
                        <td>@(r.DriverName ?? "-") @(r.DriverRating.HasValue ? $"({r.DriverRating.Value:F1}/5)" : "")</td>
                        <td class="text-muted text-sm" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@(r.Comment ?? "-")</td>
                        <td class="text-muted text-sm">@r.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (totalPages > 1)
    {
        <div style="padding:12px 18px;border-top:1px solid var(--border)">
            <div class="pagination" style="flex-wrap:wrap">
                @{
                    int windowSize = 1;
                    var pagesToShow = new List<int?> { 1 };
                    int start = Math.Max(2, page - windowSize);
                    int end = Math.Min(totalPages - 1, page + windowSize);
                    if (start > 2) pagesToShow.Add(null);
                    for (int i = start; i <= end; i++) pagesToShow.Add(i);
                    if (end < totalPages - 1) pagesToShow.Add(null);
                    if (totalPages > 1) pagesToShow.Add(totalPages);
                }
                @if (page > 1)
                {
                    <a class="page-btn" href="?page=@(page - 1)" title="@Localizer["Previous"]" aria-label="Previous">‹</a>
                }
                @foreach (var p in pagesToShow)
                {
                    if (p == null)
                    {
                        <span class="page-btn" style="cursor:default;pointer-events:none;background:transparent;border-color:transparent">…</span>
                    }
                    else
                    {

                        <a class="page-btn @(p == page ? "active" : "")" href="?page=@p">@p</a>
                    }
                }
                @if (page < totalPages)
                {
                    <a class="page-btn" href="?page=@(page + 1)" title="@Localizer["Next"]" aria-label="Next">›</a>
                }
            </div>
        </div>
    }
</div>
