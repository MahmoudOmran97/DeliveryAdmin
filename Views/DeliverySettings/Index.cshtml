@model DeliveryAdmin.Models.UpdateDeliverySettingsDto
@{
    ViewData["Title"] = Localizer["DeliveryFee_Title"];
}
<div style="max-width:700px">
    <div class="card">
        <div class="card-header">
            <div class="card-title">🚚 @Localizer["DeliveryFee_Title"]</div>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" style="margin-bottom:12px">@TempData["Error"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" style="margin-bottom:12px">@TempData["Success"]</div>
            }

            <p class="text-muted" style="margin-bottom:16px">
                @Localizer["DeliveryFee_Description"]
                <br />
                @Localizer["DeliveryFee_Example"]
            </p>

            <form method="post">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">@Localizer["DeliveryFee_FreeRadius"]</label>
                        <input class="form-control" asp-for="FreeRadiusKm" type="number" step="0.1" min="0" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">@Localizer["DeliveryFee_ExtraFeePerKm"]</label>
                        <input class="form-control" asp-for="ExtraFeePerKm" type="number" step="0.5" min="0" required>
                    </div>
                </div>

                @if (ViewBag.UpdatedAt != null)
                {
                    <p class="text-muted text-sm" style="margin-top:4px">@Localizer["DeliveryFee_LastUpdated"] @(((DateTime)ViewBag.UpdatedAt).ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</p>
                }

                <div style="display:flex;gap:8px;margin-top:12px">
                    <button class="btn btn-primary" type="submit">💾 @Localizer["DeliveryFee_SaveBtn"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
