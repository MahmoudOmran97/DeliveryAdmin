@using System.Globalization

@{
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = lang == "ar";
}

@model List<DeliveryAdmin.Models.DriverDto>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div style="display:flex;justify-content:flex-end;margin-bottom:12px">
  <button type="button" id="openLiveMapBtn" class="btn btn-primary btn-sm">@Localizer["LiveMap_OpenBtn"]</button>
</div>

<div class="stat-row">
  <div class="stat-box"><div class="stat-label">@Localizer["Drivers_TotalDrivers"]</div><div class="stat-val">@ViewBag.TotalAll</div></div>
  <div class="stat-box"><div class="stat-label">@Localizer["Drivers_OnlineNow"]</div><div class="stat-val" style="color:var(--green)">@ViewBag.TotalOnline</div></div>
  <div class="stat-box"><div class="stat-label">@Localizer["Drivers_VerifiedCount"]</div><div class="stat-val" style="color:var(--blue)">@ViewBag.TotalVerified</div></div>
  <div class="stat-box"><div class="stat-label">@Localizer["Drivers_PendingVerify"]</div><div class="stat-val" style="color:var(--amber)">@ViewBag.TotalPending</div></div>
</div>

<div class="cards-grid-3">
  @{var colors=new[]{"#f97316","#3b82f6","#22c55e","#a855f7","#f59e0b","#ef4444"};}
  @foreach(var (d,i) in Model.Take(6).Select((d,i)=>(d,i)))
  {
    <div class="card" style="padding:16px">
      <div style="display:flex;align-items:center;gap:11px;margin-bottom:12px">
        <div style="width:42px;height:42px;border-radius:50%;background:@colors[i%6]22;color:@colors[i%6];display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700">@(d.UserName?.FirstOrDefault().ToString().ToUpper()??"D")</div>
        <div>
          <div style="font-weight:700;font-size:13px">@(d.UserName??d.FullName??"Driver #"+d.Id)</div>
          <div class="text-muted text-sm">@d.VehicleType · @d.LicensePlate</div>
        </div>
        <span class="badge @(d.IsOnline?"b-online":"b-offline")" style="margin-left:auto">@(d.IsOnline?Localizer["Drivers_Online"].Value:Localizer["Drivers_Offline"].Value)</span>
      </div>
      <div style="display:flex;gap:16px;padding-top:10px;border-top:1px solid var(--border)">
        <div><div style="font-size:16px;font-weight:800">@d.TotalDeliveries</div><div class="text-muted" style="font-size:10px;text-transform:uppercase;font-weight:600">@Localizer["Drivers_Deliveries"]</div></div>
        <div><div style="font-size:16px;font-weight:800">@d.Rating.ToString("F1")</div><div class="text-muted" style="font-size:10px;text-transform:uppercase;font-weight:600">@Localizer["Drivers_Rating"]</div></div>
        <div><div style="font-size:16px;font-weight:800">@(d.IsVerified?"✓":"⏳")</div><div class="text-muted" style="font-size:10px;text-transform:uppercase;font-weight:600">@Localizer["Drivers_VerifiedCount"]</div></div>
      </div>
    </div>
  }
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">@Localizer["Drivers_AllDrivers"]</div>
    <div class="filters">
      <a class="btn btn-sm @(ViewBag.Filter==null?"btn-primary":"btn-secondary")" asp-action="Index" asp-route-search="@ViewBag.Search">@Localizer["Users_All"]</a>
      <a class="btn btn-sm @(ViewBag.Filter=="online"?"btn-success":"btn-secondary")" asp-action="Index" asp-route-filter="online" asp-route-search="@ViewBag.Search">@Localizer["Drivers_Online"]</a>
      <a class="btn btn-sm @(ViewBag.Filter=="offline"?"btn-secondary":"btn-secondary")" asp-action="Index" asp-route-filter="offline" asp-route-search="@ViewBag.Search">@Localizer["Drivers_Offline"]</a>
      <a class="btn btn-sm @(ViewBag.Filter=="verified"?"btn-primary":"btn-secondary")" asp-action="Index" asp-route-filter="verified" asp-route-search="@ViewBag.Search">@Localizer["Drivers_VerifiedCount"]</a>
      <a class="btn btn-sm @(ViewBag.Filter=="pending"?"btn-warning":"btn-secondary")" asp-action="Index" asp-route-filter="pending" asp-route-search="@ViewBag.Search">@Localizer["Drivers_Pending"]</a>
      <form method="get" style="display:flex;gap:8px">
        <input type="hidden" name="filter" value="@ViewBag.Filter" />
        <input class="filter-input" type="text" name="search" value="@ViewBag.Search" placeholder="@Localizer["Drivers_SearchPlaceholder"]" />
        <button class="btn btn-secondary btn-sm" type="submit">@Localizer["Search"]</button>
      </form>
    </div>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>@Localizer["Nav_Drivers"]</th><th>@Localizer["Drivers_Vehicle"]</th><th>@Localizer["Drivers_License"]</th><th>@Localizer["Drivers_NationalId"]</th><th>@Localizer["Drivers_Rating"]</th><th>@Localizer["Drivers_Deliveries"]</th><th>@Localizer["Status"]</th><th>@Localizer["Drivers_VerifiedCount"]</th><th>@Localizer["Joined"]</th><th>@Localizer["Actions"]</th></tr></thead>
      <tbody>
        @if(!Model.Any()){<tr><td colspan="10"><div class="empty"><div class="empty-icon">🛵</div><div>@Localizer["Drivers_NoData"]</div></div></td></tr>}
        @foreach(var d in Model)
        {
          <tr>
            <td><div style="display:flex;align-items:center;gap:8px"><div style="width:32px;height:32px;border-radius:50%;background:var(--bg4);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--text2)">@(d.UserName?.FirstOrDefault().ToString().ToUpper()??"D")</div><div><div style="font-weight:600">@(d.UserName??d.FullName??"Driver #"+d.Id)</div><div class="text-muted text-sm">@d.Email</div></div></div></td>
            <td>@d.VehicleType</td>
            <td class="mono">@d.LicensePlate</td>
            <td class="mono text-muted">@(d.NationalId??"-")</td>
            <td><span class="stars">⭐</span> @d.Rating.ToString("F1")</td>
            <td class="mono">@d.TotalDeliveries</td>
            <td><span class="badge @(d.IsOnline?"b-online":"b-offline")">@(d.IsOnline?Localizer["Drivers_Online"].Value:Localizer["Drivers_Offline"].Value)</span></td>
            <td>@if(d.IsVerified){<span class="badge b-verified">@Localizer["Drivers_VerifiedCount"]</span>}else{<span class="badge b-pending">@Localizer["Drivers_Pending"]</span>}</td>
            <td class="text-muted text-sm">@d.JoinedAt.ToString("dd MMM yyyy")</td>
            <td>
              <div style="display:flex;gap:4px;flex-wrap:wrap">
                <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@d.Id">✏️ @Localizer["Edit"]</a>
                @if(!d.IsVerified){
                  <form method="post" asp-action="Verify" asp-route-id="@d.Id">
                    <button class="btn btn-success btn-sm" type="submit">✓ @Localizer["Drivers_Verify"]</button>
                  </form>
                }
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@* ══════════════════════════════════════════════════════════
   مودال الخريطة الحية: كل السواقين + كل المحلات على خريطة واحدة
   Leaflet + OpenStreetMap (زي نفس المكتبة المستخدمة في MyStore/Settings)
   ══════════════════════════════════════════════════════════ *@
<div id="liveMapOverlay" class="live-map-overlay" style="display:none">
  <div class="live-map-modal">
    <div class="live-map-header">
      <div class="card-title">@Localizer["LiveMap_Title"]</div>
      <div style="display:flex;align-items:center;gap:10px">
        <span class="text-muted text-sm" id="liveMapUpdatedAt"></span>
        <button type="button" class="btn btn-secondary btn-sm" id="liveMapLocateBtn">@Localizer["LiveMap_UseMyLocation"]</button>
        <button type="button" class="live-map-close" id="liveMapCloseBtn">✕</button>
      </div>
    </div>
    <div class="live-map-body">
      <div class="live-map-canvas-wrap">
        <div id="liveMapCanvas"></div>
        <div class="live-map-legend">
          <div><span class="lm-dot" style="background:#22c55e"></span> @Localizer["LiveMap_Legend_Available"]</div>
          <div><span class="lm-dot" style="background:#3b82f6"></span> @Localizer["LiveMap_Legend_Busy"]</div>
          <div><span class="lm-dot" style="background:#9ca3af"></span> @Localizer["LiveMap_Legend_Offline"]</div>
          <div><span class="lm-dot" style="background:#f97316"></span> @Localizer["LiveMap_Legend_Store"]</div>
          <div><span class="lm-dot lm-pulse" style="background:#ef4444"></span> @Localizer["LiveMap_Legend_StoreBusy"]</div>
        </div>
      </div>
      <div class="live-map-sidebar">
        <div class="lm-tabs">
          <button type="button" class="lm-tab active" data-tab="drivers">🛵 @Localizer["LiveMap_DriversCount"] (<span id="lmDriversCount">0</span>)</button>
          <button type="button" class="lm-tab" data-tab="stores">🏪 @Localizer["LiveMap_StoresCount"] (<span id="lmStoresCount">0</span>)</button>
        </div>
        <div id="lmDriversList" class="lm-list"></div>
        <div id="lmStoresList" class="lm-list" style="display:none"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .live-map-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,.65);
    display: flex; align-items: center; justify-content: center;
    z-index: 1000; padding: 16px;
  }
  .live-map-modal {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 14px; width: 100%; max-width: 1180px; height: 88vh;
    display: flex; flex-direction: column; overflow: hidden;
  }
  .live-map-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 18px; border-bottom: 1px solid var(--border);
  }
  .live-map-close { background: none; border: none; color: var(--text2); font-size: 18px; cursor: pointer; }
  .live-map-body { flex: 1; display: flex; min-height: 0; }
  .live-map-canvas-wrap { position: relative; flex: 1; min-width: 0; }
  #liveMapCanvas { width: 100%; height: 100%; }
  .live-map-legend {
    position: absolute; bottom: 12px; inset-inline-start: 12px; z-index: 500;
    background: var(--bg2); border: 1px solid var(--border); border-radius: 10px;
    padding: 8px 12px; font-size: 11px; display: flex; flex-direction: column; gap: 4px;
    box-shadow: 0 4px 14px rgba(0,0,0,.25);
  }
  .live-map-legend .lm-dot { display:inline-block; width:10px; height:10px; border-radius:50%; margin-inline-end:6px; }
  .lm-pulse { box-shadow: 0 0 0 0 rgba(239,68,68,.7); animation: lmPulse 1.4s infinite; }
  @@keyframes lmPulse {
    0% { box-shadow: 0 0 0 0 rgba(239,68,68,.6); }
    70% { box-shadow: 0 0 0 8px rgba(239,68,68,0); }
    100% { box-shadow: 0 0 0 0 rgba(239,68,68,0); }
  }
  .live-map-sidebar {
    width: 300px; flex-shrink: 0; border-inline-start: 1px solid var(--border);
    display: flex; flex-direction: column; min-height: 0;
  }
  .lm-tabs { display: flex; border-bottom: 1px solid var(--border); }
  .lm-tab {
    flex: 1; padding: 10px; background: none; border: none; cursor: pointer;
    color: var(--text2); font-size: 12px; font-weight: 600; border-bottom: 2px solid transparent;
  }
  .lm-tab.active { color: var(--accent, #6366f1); border-bottom-color: var(--accent, #6366f1); }
  .lm-list { flex: 1; overflow-y: auto; padding: 8px; }
  .lm-item {
    display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 8px;
    cursor: pointer; margin-bottom: 4px;
  }
  .lm-item:hover { background: var(--bg4); }
  .lm-item-icon {
    width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 14px;
  }
  .lm-item-name { font-weight: 600; font-size: 12.5px; }
  .lm-item-sub { font-size: 11px; color: var(--text2); }
  .lm-badge-pending {
    margin-inline-start: auto; background: #ef4444; color: #fff; font-size: 10px;
    font-weight: 700; padding: 2px 6px; border-radius: 10px;
  }
  .leaflet-pane, .leaflet-control { z-index: 1; }
  .lm-driver-icon, .lm-store-icon {
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%; border: 2px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,.4);
    font-size: 15px; color: #fff;
  }
  .lm-store-badge {
    position: absolute; top: -6px; inset-inline-end: -6px; background: #ef4444; color: #fff;
    font-size: 10px; font-weight: 700; min-width: 16px; height: 16px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center; padding: 0 3px;
  }
  .lm-me-icon {
    display: flex; align-items: center; justify-content: center; font-size: 18px;
  }
</style>

@section Scripts {
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    (function () {
      const DEFAULT_LAT = 30.0444; // القاهرة كنقطة افتراضية
      const DEFAULT_LNG = 31.2357;
      const REFRESH_MS = 8000;
      const DATA_URL = '@Url.Action("LiveMapData", "Drivers")';

      const overlay = document.getElementById('liveMapOverlay');
      const openBtn = document.getElementById('openLiveMapBtn');
      const closeBtn = document.getElementById('liveMapCloseBtn');
      const locateBtn = document.getElementById('liveMapLocateBtn');
      const updatedAtEl = document.getElementById('liveMapUpdatedAt');
      const driversListEl = document.getElementById('lmDriversList');
      const storesListEl = document.getElementById('lmStoresList');
      const driversCountEl = document.getElementById('lmDriversCount');
      const storesCountEl = document.getElementById('lmStoresCount');
      const tabs = document.querySelectorAll('.lm-tab');

      let map, mapReady = false, refreshTimer = null;
      let myMarker = null, myLat = null, myLng = null;
      let driverMarkers = {}, storeMarkers = {};

      const storeEmoji = {
        Restaurant: '🍽️', Pharmacy: '💊', Grocery: '🛒', Supermarket: '🏬',
        Vegetables: '🥦', Drinks: '🥤', Accessories: '🎁'
      };

      function haversineKm(lat1, lng1, lat2, lng2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLng = (lng2 - lng1) * Math.PI / 180;
        const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * Math.PI / 180) *
                  Math.cos(lat2 * Math.PI / 180) * Math.sin(dLng / 2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }

      function ensureMap() {
        if (mapReady) return;
        map = L.map('liveMapCanvas').setView([DEFAULT_LAT, DEFAULT_LNG], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19, attribution: '© OpenStreetMap contributors'
        }).addTo(map);
        mapReady = true;
      }

      function driverIcon(driver) {
        const color = !driver.isOnline ? '#9ca3af' : (driver.isAvailable ? '#22c55e' : '#3b82f6');
        return L.divIcon({
          className: '', html: `<div class="lm-driver-icon" style="width:30px;height:30px;background:${color}">🛵</div>`,
          iconSize: [30, 30], iconAnchor: [15, 15]
        });
      }

      function storeIcon(store) {
        const emoji = storeEmoji[store.storeType] || '🏪';
        const busy = store.pendingOrders >= 3;
        const warn = store.pendingOrders > 0 && store.pendingOrders < 3;
        const bg = busy ? '#ef4444' : (warn ? '#f97316' : '#6b7280');
        const pulseClass = busy ? 'lm-pulse' : '';
        const badge = store.pendingOrders > 0
          ? `<div class="lm-store-badge">${store.pendingOrders}</div>` : '';
        return L.divIcon({
          className: '',
          html: `<div style="position:relative">
                   <div class="lm-store-icon ${pulseClass}" style="width:32px;height:32px;background:${bg}">${emoji}</div>
                   ${badge}
                 </div>`,
          iconSize: [32, 32], iconAnchor: [16, 16]
        });
      }

      function driverPopup(d, distanceTxt) {
        return `<b>${d.name}</b><br>${d.vehicleType || ''}<br>` +
          `${d.isOnline ? (d.isAvailable ? '🟢 @Localizer["LiveMap_Legend_Available"]' : '🔵 @Localizer["LiveMap_Legend_Busy"]') : '⚪ @Localizer["LiveMap_Legend_Offline"]'}` +
          (d.phone ? `<br>📞 ${d.phone}` : '') +
          (distanceTxt ? `<br>📍 ${distanceTxt}` : '');
      }

      function storePopup(s, distanceTxt) {
        return `<b>${storeEmoji[s.storeType] || '🏪'} ${s.name}</b><br>${s.address || ''}<br>` +
          `${s.isOpen ? '🟢' : '🔴'} ` +
          `${s.pendingOrders} @Localizer["LiveMap_PendingOrders"]` +
          (distanceTxt ? `<br>📍 ${distanceTxt}` : '');
      }

      function renderList(container, items, iconHtmlFn, subFn, badgeFn) {
        container.innerHTML = '';
        if (!items.length) {
          container.innerHTML = '<div class="text-muted text-sm" style="padding:12px">—</div>';
          return;
        }
        items.forEach(it => {
          const row = document.createElement('div');
          row.className = 'lm-item';
          row.innerHTML = `<div class="lm-item-icon" style="${iconHtmlFn(it)}"></div>
            <div style="min-width:0;flex:1">
              <div class="lm-item-name">${it.__name}</div>
              <div class="lm-item-sub">${subFn(it)}</div>
            </div>${badgeFn ? badgeFn(it) : ''}`;
          row.addEventListener('click', () => {
            if (map && it.__marker) { map.setView(it.__marker.getLatLng(), 15); it.__marker.openPopup(); }
          });
          container.appendChild(row);
        });
      }

      function updateMyLocation(lat, lng) {
        myLat = lat; myLng = lng;
        ensureMap();
        if (myMarker) map.removeLayer(myMarker);
        myMarker = L.marker([lat, lng], {
          icon: L.divIcon({ className: '', html: '<div class="lm-me-icon">🧭</div>', iconSize: [24, 24], iconAnchor: [12, 12] }),
          zIndexOffset: 1000
        }).addTo(map).bindPopup('@Localizer["LiveMap_UseMyLocation"]');
        map.setView([lat, lng], 13);
      }

      function refresh() {
        ensureMap();
        fetch(DATA_URL, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(r => r.json())
          .then(data => {
            updatedAtEl.textContent = new Date().toLocaleTimeString();

            // ── drivers ──
            const seenD = new Set();
            const driverItems = (data.drivers || []).map(d => {
              seenD.add(d.id);
              const pos = [d.lat, d.lng];
              if (driverMarkers[d.id]) {
                driverMarkers[d.id].setLatLng(pos).setIcon(driverIcon(d));
              } else {
                driverMarkers[d.id] = L.marker(pos, { icon: driverIcon(d) }).addTo(map);
              }
              const distKm = (myLat != null) ? haversineKm(myLat, myLng, d.lat, d.lng) : null;
              const distTxt = distKm != null ? distKm.toFixed(1) + ' كم' : '';
              driverMarkers[d.id].bindPopup(driverPopup(d, distTxt));
              d.__marker = driverMarkers[d.id];
              d.__name = d.name;
              d.__dist = distKm;
              return d;
            });
            Object.keys(driverMarkers).forEach(id => {
              if (!seenD.has(Number(id))) { map.removeLayer(driverMarkers[id]); delete driverMarkers[id]; }
            });
            driverItems.sort((a, b) => (a.__dist ?? 1e9) - (b.__dist ?? 1e9));
            driversCountEl.textContent = driverItems.length;
            renderList(driversListEl, driverItems,
              d => `background:${!d.isOnline ? '#9ca3af22' : (d.isAvailable ? '#22c55e22' : '#3b82f622')};color:${!d.isOnline ? '#9ca3af' : (d.isAvailable ? '#22c55e' : '#3b82f6')}`,
              d => (d.vehicleType || '') + (d.__dist != null ? ' · ' + d.__dist.toFixed(1) + ' كم' : ''));
            driverItems.forEach((d, i) => { driversListEl.children[i] && (driversListEl.children[i].querySelector('.lm-item-icon').textContent = '🛵'); });

            // ── stores ──
            const seenS = new Set();
            const storeItems = (data.restaurants || []).map(s => {
              seenS.add(s.id);
              const pos = [s.lat, s.lng];
              if (storeMarkers[s.id]) {
                storeMarkers[s.id].setLatLng(pos).setIcon(storeIcon(s));
              } else {
                storeMarkers[s.id] = L.marker(pos, { icon: storeIcon(s) }).addTo(map);
              }
              const distKm = (myLat != null) ? haversineKm(myLat, myLng, s.lat, s.lng) : null;
              const distTxt = distKm != null ? distKm.toFixed(1) + ' كم' : '';
              storeMarkers[s.id].bindPopup(storePopup(s, distTxt));
              s.__marker = storeMarkers[s.id];
              s.__name = s.name;
              s.__dist = distKm;
              return s;
            });
            Object.keys(storeMarkers).forEach(id => {
              if (!seenS.has(Number(id))) { map.removeLayer(storeMarkers[id]); delete storeMarkers[id]; }
            });
            storeItems.sort((a, b) => b.pendingOrders - a.pendingOrders);
            storesCountEl.textContent = storeItems.length;
            renderList(storesListEl, storeItems,
              s => `background:${s.pendingOrders >= 3 ? '#ef444422' : (s.pendingOrders > 0 ? '#f9731622' : '#6b728022')};color:${s.pendingOrders >= 3 ? '#ef4444' : (s.pendingOrders > 0 ? '#f97316' : '#6b7280')}`,
              s => (s.isOpen ? '🟢' : '🔴') + (s.__dist != null ? ' · ' + s.__dist.toFixed(1) + ' كم' : ''),
              s => s.pendingOrders > 0 ? `<span class="lm-badge-pending">${s.pendingOrders}</span>` : '');
            storeItems.forEach((s, i) => { storesListEl.children[i] && (storesListEl.children[i].querySelector('.lm-item-icon').textContent = storeEmoji[s.storeType] || '🏪'); });
          })
          .catch(() => {});
      }

      function openModal() {
        overlay.style.display = 'flex';
        ensureMap();
        setTimeout(() => map.invalidateSize(), 50);
        refresh();
        refreshTimer = setInterval(refresh, REFRESH_MS);
        if (navigator.geolocation && myLat == null) {
          navigator.geolocation.getCurrentPosition(
            pos => updateMyLocation(pos.coords.latitude, pos.coords.longitude),
            () => {}
          );
        }
      }

      function closeModal() {
        overlay.style.display = 'none';
        if (refreshTimer) { clearInterval(refreshTimer); refreshTimer = null; }
      }

      openBtn.addEventListener('click', openModal);
      closeBtn.addEventListener('click', closeModal);
      overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
      locateBtn.addEventListener('click', () => {
        if (!navigator.geolocation) return;
        navigator.geolocation.getCurrentPosition(
          pos => { updateMyLocation(pos.coords.latitude, pos.coords.longitude); refresh(); },
          () => alert('تعذر تحديد موقعك')
        );
      });
      tabs.forEach(tab => tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        driversListEl.style.display = tab.dataset.tab === 'drivers' ? 'block' : 'none';
        storesListEl.style.display = tab.dataset.tab === 'stores' ? 'block' : 'none';
      }));
    })();
  </script>
}
